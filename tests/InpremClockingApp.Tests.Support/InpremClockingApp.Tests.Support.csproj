<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test infrastructure: database provisioning, app host factory, seeded test data
       and sign-in helpers. Referenced by every test project that needs the running app. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test projects that create their own app hosts (e.g. the host-isolation suite). -->
    <InternalsVisibleTo Include="Inprem.Platform.Tests.Integration" />
    <InternalsVisibleTo Include="InpremClockingApp.Tests.Baseline" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\InpremClockingApp\InpremClockingApp.csproj" />
  </ItemGroup>

</Project>
