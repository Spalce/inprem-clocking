@page "{id:int}"
@model InpremClockingApp.Areas.Provider.Pages.Tenants.ReactivateModel
@{
    ViewData["Title"] = "Reactivate organization";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Details" asp-route-id="@RouteData.Values["id"]">&larr; Back to the organization</a></p>
<h1 class="pc-title">Reactivate @Model.Name?</h1>
<p class="pc-subtitle">The organization is marked active again.</p>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

<form method="post" class="pc-card pc-form">
  <div class="pc-field">
    <label for="Reason">Reason <span class="pc-muted">(required; recorded in the audit log)</span></label>
    <textarea id="Reason" name="Reason" rows="3" maxlength="500" required>@Model.Reason</textarea>
  </div>
  <div class="pc-actions">
    <button type="submit" class="pc-btn pc-btn-primary" data-testid="confirm">Reactivate</button>
    <a asp-page="Details" asp-route-id="@RouteData.Values["id"]" class="pc-btn">Cancel</a>
  </div>
</form>
