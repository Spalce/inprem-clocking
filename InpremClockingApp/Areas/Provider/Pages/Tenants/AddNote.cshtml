@page "{id:int}"
@model InpremClockingApp.Areas.Provider.Pages.Tenants.AddNoteModel
@{
    ViewData["Title"] = "Add note";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Details" asp-route-id="@RouteData.Values["id"]" asp-route-tab="notes">&larr; Back to the organization</a></p>
<h1 class="pc-title">Add a note to @Model.Name</h1>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

<form method="post" class="pc-card pc-form">
  <div class="pc-field">
    <label for="Text">Note</label>
    <textarea id="Text" name="Text" rows="5" maxlength="2000" required>@Model.Text</textarea>
  </div>
  <div class="pc-actions">
    <button type="submit" class="pc-btn pc-btn-primary">Add note</button>
    <a asp-page="Details" asp-route-id="@RouteData.Values["id"]" asp-route-tab="notes" class="pc-btn">Cancel</a>
  </div>
</form>
