@page "{id:int}"
@model InpremClockingApp.Areas.Provider.Pages.Tenants.DetailsModel
@{
    var org = Model.Organization;
    var s = org.Summary;
    ViewData["Title"] = s.Name;
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Index">&larr; Organizations</a></p>
<div class="pc-heading">
  <div>
    <h1 class="pc-title">@s.Name <span class="pc-badge pc-badge-@s.Status.ToString().ToLowerInvariant()">@s.Status</span></h1>
    <p class="pc-subtitle"><code>@s.Slug</code> &middot; created @s.CreatedUtc.ToString("yyyy-MM-dd")</p>
  </div>
  <div class="pc-actions">
  @if (Model.CanSupport)
  {
      <a asp-page="StartSupport" asp-route-id="@s.TenantId" class="pc-btn" data-testid="start-support"><i class="fas fa-headset"></i> Start support session</a>
  }
  </div>
  @if (Model.IsOwner)
  {
      <div class="pc-actions">
        <a asp-page="Edit" asp-route-id="@s.TenantId" class="pc-btn" data-testid="edit"><i class="fas fa-pen"></i> Edit</a>
        <a asp-page="SignInCodes" asp-route-id="@s.TenantId" class="pc-btn" data-testid="sign-in-codes"><i class="fas fa-mobile-screen"></i> Sign-in codes</a>
        <a asp-page="Texts" asp-route-id="@s.TenantId" class="pc-btn" data-testid="texts"><i class="fas fa-comment-sms"></i> Texts</a>
        @if (s.Status == OrganizationStatus.Active)
        {
            <a asp-page="Suspend" asp-route-id="@s.TenantId" class="pc-btn pc-btn-danger" data-testid="suspend">Suspend</a>
        }
        else
        {
            <a asp-page="Reactivate" asp-route-id="@s.TenantId" class="pc-btn" data-testid="reactivate">Reactivate</a>
        }
      </div>
  }
</div>

@if (TempData["Success"] is string success)
{
    <div class="pc-success" data-testid="success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="pc-error" data-testid="error">@error</div>
}

<nav class="pc-tabs" data-testid="tabs">
  @foreach (var (key, title) in DetailsModel.Tabs)
  {
      <a asp-page="Details" asp-route-id="@s.TenantId" asp-route-tab="@key" class="@(Model.Tab == key ? "pc-tab-current" : null)">@title</a>
  }
</nav>

<div class="pc-card" data-testid="tab-@Model.Tab">
@switch (Model.Tab)
{
    case "subscription":
        if (Model.Billing?.Subscription is not { } sub)
        {
            <p class="pc-muted">No subscription on record.</p>
        }
        else
        {
            var b = Model.Billing;
            <dl class="pc-dl" data-testid="subscription">
              <dt>Plan</dt><dd>@(b.Plan?.Name ?? "No plan")</dd>
              <dt>Price</dt><dd>@(b.Price == null ? "—" : Inprem.Platform.Application.Billing.PlanService.Describe(b.Price))</dd>
              <dt>Billing</dt><dd>@sub.Mode</dd>
              <dt>Status</dt><dd><span class="pc-badge" data-testid="subscription-status">@sub.Status</span> @(b.Access.FullAccess ? "(full access)" : "(read-only)")</dd>
              <dt>Trial ends</dt><dd>@(sub.TrialEndsUtc?.ToString("yyyy-MM-dd") ?? "—")</dd>
              <dt>Paid period</dt><dd>@(sub.CurrentPeriodStartUtc?.ToString("yyyy-MM-dd") ?? "—") to @(sub.CurrentPeriodEndUtc?.ToString("yyyy-MM-dd") ?? "—")@(sub.CancelAtPeriodEnd ? " (cancelled: ends then)" : "")</dd>
              <dt>Outstanding</dt><dd>@sub.OutstandingBalance.ToString("0.00")</dd>
              <dt>PayPal subscription</dt><dd>@(sub.ExternalSubscriptionId ?? "—")</dd>
              <dt>Free access until</dt><dd data-testid="free-access">@(sub.FreeAccessUntilUtc?.ToString("yyyy-MM-dd") ?? "—")</dd>
              <dt>People limit</dt><dd>@(sub.MaxPeopleOverride?.ToString() ?? b.Plan?.MaxPeople?.ToString() ?? "No limit")@(sub.MaxPeopleOverride != null ? " (override)" : "")</dd>
              <dt>Since</dt><dd>@sub.CreatedUtc.ToString("yyyy-MM-dd")</dd>
            </dl>
            @if (Model.CanBill)
            {
                <div class="pc-actions" style="margin-top:12px">
                  @if (sub.Status is Inprem.Platform.Domain.Billing.SubscriptionStatus.Trialing or Inprem.Platform.Domain.Billing.SubscriptionStatus.Expired && sub.ExternalSubscriptionId == null)
                  {
                      <a asp-page="ExtendTrial" asp-route-id="@s.TenantId" class="pc-btn" data-testid="extend-trial">Extend trial</a>
                  }
                  <a asp-page="FreeAccess" asp-route-id="@s.TenantId" class="pc-btn" data-testid="free-access-link">Free access</a>
                  @if (sub.ExternalSubscriptionId != null)
                  {
                      <form method="post" asp-page-handler="Sync" asp-route-id="@s.TenantId" class="pc-inline">
                        <button type="submit" class="pc-btn" data-testid="sync"><i class="fas fa-sync"></i> Sync with PayPal</button>
                      </form>
                  }
                  @if (b.PaysByPayPal)
                  {
                      <a asp-page="CancelSubscription" asp-route-id="@s.TenantId" class="pc-btn pc-btn-danger" data-testid="cancel-subscription">Cancel subscription</a>
                  }
                </div>
            }
        }
        break;

    case "invoices":
        <h2 class="pc-section">Invoices</h2>
        @if (Model.CanBill)
        {
            <p><a asp-page="/Billing/Invoices/New" asp-route-tenantId="@org.Summary.TenantId" class="pc-btn pc-btn-primary" data-testid="new-invoice">+ New invoice</a></p>
            @if (Model.Invoices.Count == 0)
            {
                <p class="pc-muted">No invoices yet.</p>
            }
            else
            {
                <table class="pc-table" data-testid="invoices">
                  <thead><tr><th>Number</th><th>Status</th><th>Total</th><th>To pay</th><th>Issued</th><th>Due</th></tr></thead>
                  <tbody>
                  @foreach (var i in Model.Invoices)
                  {
                      <tr><td><a asp-page="/Billing/Invoices/Details" asp-route-id="@i.Id">@i.Number</a></td><td><span class="pc-badge">@i.Status</span></td>
                          <td>@Inprem.Platform.Application.Billing.InvoiceService.Money(i.Total, i.Currency)</td>
                          <td>@(i.Outstanding > 0 ? Inprem.Platform.Application.Billing.InvoiceService.Money(i.Outstanding, i.Currency) : "")</td>
                          <td>@i.IssueDate.ToString("yyyy-MM-dd")</td><td>@i.DueDate.ToString("yyyy-MM-dd")</td></tr>
                  }
                  </tbody>
                </table>
            }
        }
        else
        {
            <p class="pc-muted">Invoices are shown to Billing users and Owners.</p>
        }
        <h2 class="pc-section">Payments</h2>
        @if (Model.Billing == null || Model.Billing.Payments.Count == 0)
        {
            <p class="pc-muted">No payments yet.</p>
        }
        else
        {
            <table class="pc-table" data-testid="payments">
              <thead><tr><th>Paid (UTC)</th><th>Amount</th><th>Source</th><th>Status</th><th>Reference</th><th></th></tr></thead>
              <tbody>
              @foreach (var p in Model.Billing.Payments)
              {
                  <tr><td>@p.PaidUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@p.Amount.ToString("0.00") @p.Currency</td><td>@p.Source</td>
                      <td>@p.Status@(p.RefundedAmount > 0 ? $" ({p.RefundedAmount:0.00})" : "")</td><td>@p.ExternalId</td>
                      <td>@if (Model.CanBill && p.Status != Inprem.Platform.Domain.Billing.PaymentStatus.Reversed && p.RefundedAmount < p.Amount)
                          {
                              <a asp-page="/Billing/Payments/Refund" asp-route-id="@p.Id" class="pc-btn pc-btn-small" data-testid="refund">Refund</a>
                          }</td></tr>
              }
              </tbody>
            </table>
        }
        break;

    case "admins":
        <table class="pc-table" data-testid="admins">
          <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th>Two-factor</th><th></th></tr></thead>
          <tbody>
          @foreach (var admin in org.Admins)
          {
              <tr>
                <td>@(string.IsNullOrWhiteSpace(admin.Name) ? "—" : admin.Name)</td>
                <td>@admin.Email</td>
                <td>@admin.Role</td>
                <td>@admin.Status@(admin.HasPassword ? "" : " (no password yet)")</td>
                <td>@(admin.LastSignInUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                <td>@(admin.TwoFactorEnabled ? "On" : "Off")</td>
                <td class="pc-actions">
                  @if (!admin.HasPassword || admin.Status == MembershipStatus.Invited)
                  {
                      <form method="post" asp-page-handler="Resend" asp-route-id="@s.TenantId" asp-route-userId="@admin.UserId" class="pc-inline">
                        <button type="submit" class="pc-btn pc-btn-small" data-testid="resend">Resend invitation</button>
                      </form>
                  }
                  else if (admin.Status == MembershipStatus.Active)
                  {
                      <form method="post" asp-page-handler="Reset" asp-route-id="@s.TenantId" asp-route-userId="@admin.UserId" class="pc-inline">
                        <button type="submit" class="pc-btn pc-btn-small" data-testid="reset">Send password reset</button>
                      </form>
                  }
                  @if (Model.IsOwner && admin.Status == MembershipStatus.Active && admin.Role != MembershipRole.Owner)
                  {
                      <a asp-page="TransferOwnership" asp-route-id="@s.TenantId" asp-route-userId="@admin.UserId" class="pc-btn pc-btn-small" data-testid="make-owner">Make owner</a>
                  }
                </td>
              </tr>
          }
          @if (org.Admins.Count == 0)
          {
              <tr><td colspan="7" class="pc-muted">No admins.</td></tr>
          }
          </tbody>
        </table>
        break;

    case "kiosk":
        <p class="pc-muted">Open kiosk sessions are listed here once kiosk sessions (Kiosk:SessionMode, Phase 7) are switched on.</p>
        break;

    case "messages":
        <p data-testid="messages">This organization's emails and texts are in the delivery log:
          <a asp-page="/Notifications/Index" asp-route-TenantId="@s.TenantId" class="pc-btn pc-btn-small" data-testid="messages-log">Open the delivery log</a>
          <span class="pc-muted">(Owners)</span></p>
        <p><a asp-page="Texts" asp-route-id="@s.TenantId">Texts settings</a> &middot; <a asp-page="SignInCodes" asp-route-id="@s.TenantId">Sign-in codes</a></p>
        break;

    case "audit":
        <table class="pc-table" data-testid="audit">
          <thead><tr><th>When (UTC)</th><th>Who</th><th>What</th><th>Details</th></tr></thead>
          <tbody>
          @foreach (var entry in org.Audit)
          {
              <tr><td>@entry.OccurredUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@entry.Actor</td><td><code>@entry.Action</code></td><td>@entry.Details</td></tr>
          }
          @if (org.Audit.Count == 0)
          {
              <tr><td colspan="4" class="pc-muted">Nothing recorded yet.</td></tr>
          }
          </tbody>
        </table>
        break;

    case "notes":
        <p><a asp-page="AddNote" asp-route-id="@s.TenantId" class="pc-btn" data-testid="add-note"><i class="fas fa-plus"></i> Add note</a></p>
        @foreach (var note in org.Notes)
        {
            <div class="pc-note">
              <div class="pc-muted">@note.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC &middot; @note.Author</div>
              <div>@note.Text</div>
            </div>
        }
        @if (org.Notes.Count == 0)
        {
            <p class="pc-muted">No notes yet.</p>
        }
        break;

    default:
        @foreach (var session in Model.ActiveSupport)
        {
            <div class="pc-error" data-testid="active-support">
              Support session in progress: @session.ProviderEmail until @session.ExpiresUtc.ToString("HH:mm") UTC — @session.Reason
              @if (Model.CanSupport)
              {
                  <form method="post" asp-page-handler="EndSupport" asp-route-id="@s.TenantId" asp-route-sessionId="@session.Id" class="pc-inline"
                        onsubmit="return confirm('End this support session now? The person in it is signed out of the organization at their next click.');">
                    <button type="submit" class="pc-btn pc-btn-small" data-testid="end-support">End now</button>
                  </form>
              }
            </div>
        }
        <dl class="pc-dl" data-testid="overview">
          <dt>Status</dt><dd>@s.Status@(org.StatusReason == null ? "" : $" — {org.StatusReason}")@(org.StatusChangedUtc == null ? "" : $" ({org.StatusChangedUtc:yyyy-MM-dd})")</dd>
          <dt>Owner</dt><dd>@(s.OwnerEmails.Count == 0 ? "—" : string.Join(", ", s.OwnerEmails))</dd>
          <dt>Time zone</dt><dd>@org.TimeZoneId</dd>
          <dt>Address</dt><dd>@(org.Address ?? "—")</dd>
          <dt>Contact</dt><dd>@(org.ContactInfo ?? "—")</dd>
          <dt>Staff</dt><dd>@org.Staff</dd>
          <dt>Volunteers</dt><dd>@org.Volunteers</dd>
          <dt>Plan</dt><dd>@(s.PlanName ?? "—")</dd>
          <dt>Last activity</dt><dd>@(s.LastActivityUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
        </dl>
        break;
}
</div>
