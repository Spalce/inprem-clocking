@page
@model InpremClockingApp.Areas.Provider.Pages.Billing.Invoices.NewModel
@using Inprem.Platform.Application.Billing
@using Inprem.Platform.Domain.Billing
@{
    ViewData["Title"] = "New invoice";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Index">&larr; Invoices</a></p>
<h1 class="pc-title">New invoice</h1>
<p class="pc-subtitle">For special cases: setup, extra work, a balance. A PayPal invoice is emailed by PayPal with a payment link; an offline invoice is emailed by us and paid by bank transfer, cash, cheque or mobile money.</p>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

@if (Model.Reviewing)
{
    <div class="pc-card" data-testid="review">
      <h2 class="pc-section">Review</h2>
      <dl class="pc-dl">
        <dt>Organization</dt><dd>@Model.TenantName</dd>
        <dt>Payment</dt><dd>@(Model.Source == InvoiceSource.Manual ? "Offline (we email the invoice)" : "PayPal (PayPal emails the invoice with a payment link)")</dd>
        <dt>Due date</dt><dd>@Model.DueDate?.ToString("yyyy-MM-dd")</dd>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <dt>Note</dt><dd>@Model.Notes</dd>
        }
      </dl>
      <table class="pc-table">
        <thead><tr><th>Item</th><th>Quantity</th><th>Price</th><th>Amount</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Filled)
        {
            <tr><td>@l.Description</td><td>@l.Quantity.ToString("0.##")</td><td>@InvoiceService.Money(l.UnitAmount, "USD")</td><td>@InvoiceService.Money(l.Quantity * l.UnitAmount, "USD")</td></tr>
        }
        <tr><td colspan="3"><strong>Total</strong></td><td><strong data-testid="total">@InvoiceService.Money(Model.Total, "USD")</strong></td></tr>
        </tbody>
      </table>
    </div>
}

<form method="post" class="pc-card pc-form">
  @if (Model.Reviewing)
  {
      @* The values travel with the form: nothing is saved until "Create and send". *@
      <input type="hidden" name="TenantId" value="@Model.TenantId" />
      <input type="hidden" name="Source" value="@Model.Source" />
      <input type="hidden" name="DueDate" value="@Model.DueDate?.ToString("yyyy-MM-dd")" />
      <input type="hidden" name="Notes" value="@Model.Notes" />
      @for (var i = 0; i < Model.Lines.Count; i++)
      {
          <input type="hidden" name="Lines[@i].Description" value="@Model.Lines[i].Description" />
          <input type="hidden" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
          <input type="hidden" name="Lines[@i].UnitAmount" value="@Model.Lines[i].UnitAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
      }
      <div class="pc-actions">
        <button type="submit" asp-page-handler="Create" class="pc-btn pc-btn-primary" data-testid="create">Create and send</button>
        <button type="submit" asp-page-handler="Edit" class="pc-btn">Back to editing</button>
      </div>
  }
  else
  {
      <div class="pc-field">
        <label for="TenantId">Organization</label>
        <select id="TenantId" name="TenantId" required>
          <option value="">Choose…</option>
          @foreach (var (id, name) in Model.Organizations)
          {
              <option value="@id" selected="@(Model.TenantId == id)">@name</option>
          }
        </select>
      </div>
      <div class="pc-field">
        <label for="Source">Payment</label>
        <select id="Source" name="Source">
          <option value="@InvoiceSource.PayPalInvoice" selected="@(Model.Source == InvoiceSource.PayPalInvoice)">PayPal invoice (paid online)</option>
          <option value="@InvoiceSource.Manual" selected="@(Model.Source == InvoiceSource.Manual)">Offline (bank transfer, cash, cheque, mobile money)</option>
        </select>
      </div>
      <table class="pc-table" data-testid="lines">
        <thead><tr><th>Item (up to 200 characters)</th><th>Quantity</th><th>Price (USD)</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            <tr>
              <td><input type="text" name="Lines[@i].Description" value="@Model.Lines[i].Description" maxlength="200" aria-label="Item @(i + 1)" /></td>
              <td><input type="number" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0.01" step="0.01" aria-label="Quantity @(i + 1)" /></td>
              <td><input type="number" name="Lines[@i].UnitAmount" value="@Model.Lines[i].UnitAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" aria-label="Price @(i + 1)" /></td>
            </tr>
        }
        </tbody>
      </table>
      <p class="pc-muted">Empty rows are left out.</p>
      <div class="pc-field">
        <label for="DueDate">Due date</label>
        <input type="date" id="DueDate" name="DueDate" value="@Model.DueDate?.ToString("yyyy-MM-dd")" required />
      </div>
      <div class="pc-field">
        <label for="Notes">Note to the organization <span class="pc-muted">(optional; printed on the invoice)</span></label>
        <textarea id="Notes" name="Notes" rows="3" maxlength="1000">@Model.Notes</textarea>
      </div>
      <div class="pc-actions">
        <button type="submit" asp-page-handler="Review" class="pc-btn pc-btn-primary" data-testid="review-button">Review</button>
        <a asp-page="Index" class="pc-btn">Cancel</a>
      </div>
  }
</form>
