@page "{id:guid}"
@model NewPriceModel
@{
    ViewData["Title"] = "Add price";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Details" asp-route-id="@RouteData.Values["id"]">&larr; Back to the plan</a></p>
<h1 class="pc-title">Add a price to @Model.PlanName</h1>
<p class="pc-subtitle">One active price per billing cycle: to change an amount, retire the old price after adding the new one.</p>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

<form method="post" class="pc-card pc-form">
  <partial name="_PriceFields" model="Model.Price" />
  <div class="pc-actions">
    <button type="submit" class="pc-btn pc-btn-primary">Add price</button>
    <a asp-page="Details" asp-route-id="@RouteData.Values["id"]" class="pc-btn">Cancel</a>
  </div>
</form>
