@page
@model InpremClockingApp.Areas.Provider.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Change temporary password";
}

<div class="@ProviderUi.Card">
    <h1 class="@ProviderUi.Title">Change your temporary password</h1>
    <p class="@ProviderUi.Lead">Choose a new password before setting up your authenticator app.</p>
    @if (Model.Error != null)
    {
        <div class="@ProviderUi.Error" data-testid="error">@Model.Error</div>
    }
    <form method="post">
        <label class="@ProviderUi.Label" for="CurrentPassword">Temporary password</label>
        <input class="@ProviderUi.Input" id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required />
        <label class="@ProviderUi.Label" for="NewPassword">New password</label>
        <input class="@ProviderUi.Input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" required />
        <label class="@ProviderUi.Label" for="ConfirmPassword">Confirm new password</label>
        <input class="@ProviderUi.Input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
        <button type="submit" class="@ProviderUi.Button">Change password</button>
    </form>
</div>