@page "{userId}"
@model InpremClockingApp.Areas.Provider.Pages.Users.DisableModel
@{
    ViewData["Title"] = "Disable provider user";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Details" asp-route-userId="@Model.Person.UserId">&larr; Back</a></p>
<h1 class="pc-title">Disable @Model.Person.Email?</h1>
<p class="pc-subtitle">They can no longer sign in, every session they have ends now, and any setup link stops working. All owners and the security mailbox are told.</p>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

<form method="post" class="pc-card pc-form">
  <div class="pc-field">
    <label for="Reason">Reason <span class="pc-muted">(required; recorded and sent to the owners)</span></label>
    <textarea id="Reason" name="Reason" rows="3" maxlength="500" required>@Model.Reason</textarea>
  </div>
  <div class="pc-actions">
    <button type="submit" class="pc-btn pc-btn-danger" data-testid="confirm">Disable</button>
    <a asp-page="Details" asp-route-userId="@Model.Person.UserId" class="pc-btn">Cancel</a>
  </div>
</form>
