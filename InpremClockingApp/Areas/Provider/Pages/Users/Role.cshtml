@page "{userId}"
@model InpremClockingApp.Areas.Provider.Pages.Users.RoleModel
@{
    ViewData["Title"] = "Change role";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Details" asp-route-userId="@Model.Person.UserId">&larr; Back</a></p>
<h1 class="pc-title">Change the role of @Model.Person.Email</h1>
<p class="pc-subtitle">Currently @Model.Person.Role. You may be asked for a code from your authenticator app.</p>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

<form method="post" class="pc-card pc-form">
  <div class="pc-field">
    <label for="Role">New role</label>
    <select id="Role" name="Role">
      @foreach (var role in Enum.GetValues<ProviderRole>())
      {
          <option value="@role" selected="@(Model.Role == role)">@role</option>
      }
    </select>
  </div>
  <div class="pc-actions">
    <button type="submit" class="pc-btn pc-btn-primary" data-testid="confirm">Save</button>
    <a asp-page="Details" asp-route-userId="@Model.Person.UserId" class="pc-btn">Cancel</a>
  </div>
</form>
