@page
@model InpremClockingApp.Areas.Provider.Pages.Users.InviteModel
@{
    ViewData["Title"] = "Invite provider user";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<p><a asp-page="Index">&larr; Provider users</a></p>
<h1 class="pc-title">Invite a provider user</h1>
    <p class="pc-subtitle">A temporary password is displayed once after creation. Use an address that has no organization account.</p>

@if (Model.Error != null)
{
    <div class="pc-error" data-testid="error">@Model.Error</div>
}

<form method="post" class="pc-card pc-form">
  <div class="pc-field"><label for="Email">Email</label><input id="Email" name="Email" type="email" value="@Model.Email" required /></div>
  <div class="pc-field">
    <label for="Role">Role</label>
    <select id="Role" name="Role">
      <option value="Support" selected="@(Model.Role == ProviderRole.Support)">Support — dashboard, organizations, plans (view), notes</option>
      <option value="Billing" selected="@(Model.Role == ProviderRole.Billing)">Billing — Support, plus plans, billing and webhooks</option>
      <option value="Owner" selected="@(Model.Role == ProviderRole.Owner)">Owner — everything, including provider users and settings</option>
    </select>
  </div>
  <div class="pc-actions">
    <button type="submit" class="pc-btn pc-btn-primary" data-testid="confirm">Create provider</button>
    <a asp-page="Index" class="pc-btn">Cancel</a>
  </div>
</form>
