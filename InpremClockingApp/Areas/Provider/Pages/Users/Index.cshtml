@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = ProviderPolicies.Owner)]
@inject ProviderSecurityService Provider
@{
    ViewData["Title"] = "Provider users";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
    var users = await Provider.ListProviderUsersAsync();
}

<div class="pc-heading">
  <div>
    <h1 class="pc-title">Provider users</h1>
    <p class="pc-subtitle">The provider team: owners, billing and support. Everyone signs in with two-factor.</p>
  </div>
  <a asp-page="Invite" class="pc-btn pc-btn-primary" data-testid="new"><i class="fas fa-plus"></i> Invite</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="pc-success" data-testid="success">@success</div>
}

<table class="pc-table" data-testid="users">
  <thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Two-factor</th><th>Since</th></tr></thead>
  <tbody>
  @foreach (var user in users)
  {
      <tr>
        <td><a asp-page="Details" asp-route-userId="@user.UserId">@user.Email</a></td>
        <td>@user.Role</td>
        <td><span class="pc-badge pc-badge-@(user.Status == ProviderUserStatus.Active ? "active" : user.Status == ProviderUserStatus.Disabled ? "suspended" : "retired")">@user.Status</span></td>
        <td>@(user.TwoFactorEnabled ? "On" : "Not set up")</td>
        <td>@user.CreatedUtc.ToString("yyyy-MM-dd")</td>
      </tr>
  }
  </tbody>
</table>
