@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Areas/Provider/Pages/Shared/_ConsoleLayout.cshtml";
}

<h1 class="pc-title">Dashboard</h1>
<p class="pc-subtitle">Welcome to the Inprem Provider Console.</p>
<div class="pc-card" data-testid="dashboard">
  <p style="margin:0">Active Provider Owners with two-factor: <strong>@Model.Owners.EnrolledOwners</strong> (at least @Inprem.Platform.Application.Provider.OwnerStatus.Minimum needed before production).</p>
  <p class="pc-muted" style="margin:8px 0 0">The dashboard's figures arrive in step 1.6.</p>
</div>
