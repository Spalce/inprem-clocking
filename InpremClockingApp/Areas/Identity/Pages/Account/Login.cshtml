@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";

    var input = "tw:w-full tw:rounded-md tw:border tw:border-slate-300 tw:px-3 tw:py-2 tw:text-sm tw:text-slate-900 tw:focus:border-blue-500 tw:focus:outline-none tw:focus:ring-1 tw:focus:ring-blue-500";
    var label = "tw:mb-1 tw:block tw:text-sm tw:font-medium tw:text-slate-700";
    var btnPrimary = "tw:inline-flex tw:w-full tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
}

<div class="tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-8 tw:shadow-sm">
    <h1 class="tw:mb-4 tw:text-center tw:text-lg tw:font-semibold tw:text-slate-900">Admin Log in only</h1>

    <form asp-page="Login" method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="tw:mb-3 tw:text-sm tw:text-red-600"></div>
        <div class="tw:mb-4">
            <label class="@label">Email</label>
            <input asp-for="Input.Email" type="email" class="@input" placeholder="Email">
        </div>
        <div class="tw:mb-4">
            <label class="@label">Password</label>
            <input asp-for="Input.Password" type="password" class="@input" placeholder="Password">
        </div>
        <div class="tw:mb-4 tw:flex tw:items-center tw:gap-2">
            <input asp-for="Input.RememberMe" type="checkbox" id="remember" class="tw:h-4 tw:w-4 tw:rounded tw:border-slate-300">
            <label for="remember" class="tw:text-sm tw:text-slate-700">
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>
        </div>
        <button type="submit" class="@btnPrimary">Log in</button>
    </form>

    <p class="tw:mt-4 tw:text-center tw:text-sm">
        <a asp-area="Identity" asp-page="ForgotPassword" class="tw:text-blue-600 tw:hover:underline">Forgot your password?</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
