@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-8 tw:text-center tw:shadow-sm">
    <h1 class="tw:mb-2 tw:text-xl tw:font-semibold tw:text-slate-900">@ViewData["Title"]</h1>
    <p class="tw:text-sm tw:text-slate-600">
        Your password has been reset. Please <a asp-page="./Login" class="tw:text-blue-600 tw:hover:underline">click here to log in</a>.
    </p>
</div>
