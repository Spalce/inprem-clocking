@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    var input = "tw:w-full tw:rounded-md tw:border tw:border-slate-300 tw:px-3 tw:py-2 tw:text-sm tw:text-slate-900 tw:focus:border-blue-500 tw:focus:outline-none tw:focus:ring-1 tw:focus:ring-blue-500";
    var label = "tw:mb-1 tw:block tw:text-sm tw:font-medium tw:text-slate-700";
    var validation = "tw:mt-1 tw:block tw:text-xs tw:text-red-600";
    var btnPrimary = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
}

<h3 class="tw:mb-4 tw:text-lg tw:font-semibold tw:text-slate-900">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="tw:max-w-md">
    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="tw:mb-3 tw:text-sm tw:text-red-600"></div>
        <div class="tw:mb-4">
            <label asp-for="Input.OldPassword" class="@label"></label>
            <input asp-for="Input.OldPassword" class="@input" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.OldPassword" class="@validation"></span>
        </div>
        <div class="tw:mb-4">
            <label asp-for="Input.NewPassword" class="@label"></label>
            <input asp-for="Input.NewPassword" class="@input" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.NewPassword" class="@validation"></span>
        </div>
        <div class="tw:mb-4">
            <label asp-for="Input.ConfirmPassword" class="@label"></label>
            <input asp-for="Input.ConfirmPassword" class="@input" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="@validation"></span>
        </div>
        <button type="submit" class="@btnPrimary tw:w-full">Update password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
