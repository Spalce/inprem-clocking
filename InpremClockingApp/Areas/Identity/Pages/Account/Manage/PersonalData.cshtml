@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
    var btnPrimary = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
    var btnDanger = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-red-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-red-700";
}

<h3 class="tw:mb-4 tw:text-lg tw:font-semibold tw:text-slate-900">@ViewData["Title"]</h3>

<div class="tw:max-w-md">
    <p class="tw:mb-2 tw:text-sm tw:text-slate-600">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
    <p class="tw:mb-4 tw:text-sm tw:text-slate-600">
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </p>
    <form id="download-data" asp-page="DownloadPersonalData" method="post" class="tw:mb-4">
        <button class="@btnPrimary" type="submit">Download</button>
    </form>
    <a id="delete" asp-page="DeletePersonalData" class="@btnDanger">Delete</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
