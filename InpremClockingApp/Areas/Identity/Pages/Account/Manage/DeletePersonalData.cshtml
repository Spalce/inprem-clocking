@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
    var input = "tw:w-full tw:rounded-md tw:border tw:border-slate-300 tw:px-3 tw:py-2 tw:text-sm tw:text-slate-900 tw:focus:border-blue-500 tw:focus:outline-none tw:focus:ring-1 tw:focus:ring-blue-500";
    var label = "tw:mb-1 tw:block tw:text-sm tw:font-medium tw:text-slate-700";
    var validation = "tw:mt-1 tw:block tw:text-xs tw:text-red-600";
    var btnDanger = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-red-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-red-700";
}

<h3 class="tw:mb-4 tw:text-lg tw:font-semibold tw:text-slate-900">@ViewData["Title"]</h3>

<div class="tw:mb-4 tw:rounded-md tw:bg-amber-50 tw:p-3 tw:text-sm tw:text-amber-800" role="alert">
    <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
</div>

<div class="tw:max-w-md">
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="tw:mb-3 tw:text-sm tw:text-red-600"></div>
        @if (Model.RequirePassword)
        {
            <div class="tw:mb-4">
                <label asp-for="Input.Password" class="@label"></label>
                <input asp-for="Input.Password" class="@input" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="@validation"></span>
            </div>
        }
        <button class="@btnDanger tw:w-full" type="submit">Delete data and close my account</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
