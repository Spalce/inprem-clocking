@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-6 tw:sm:px-6 tw:lg:px-8">
  <div class="tw:mb-6 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
    <h1 class="tw:text-2xl tw:font-semibold tw:text-slate-900">Manage Account</h1>
    <nav class="tw:text-sm tw:text-slate-500">
      <a href="#" class="tw:hover:text-slate-700">Home</a>
      <span class="tw:mx-1">/</span>
      <span class="tw:text-slate-700">Manage Account</span>
    </nav>
  </div>

  <div class="tw:grid tw:grid-cols-1 tw:gap-6 tw:lg:grid-cols-4">
    <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white">
      <partial name="_ManageNav" />
    </div>
    <div class="tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-6 tw:shadow-sm tw:lg:col-span-3">
      @RenderBody()
    </div>
  </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
