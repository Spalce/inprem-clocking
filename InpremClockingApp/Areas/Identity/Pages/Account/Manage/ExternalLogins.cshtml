@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Manage your external logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
    var btnPrimary = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
}

<partial name="_StatusMessage" for="StatusMessage" />
@if (Model.CurrentLogins?.Count > 0)
{
    <h3 class="tw:mb-3 tw:text-lg tw:font-semibold tw:text-slate-900">Registered Logins</h3>
    <div class="tw:mb-6 tw:overflow-hidden tw:rounded-lg tw:border tw:border-slate-200">
        <table class="tw:min-w-full tw:divide-y tw:divide-slate-200">
            <tbody class="tw:divide-y tw:divide-slate-100">
                @foreach (var login in Model.CurrentLogins)
                {
                    <tr>
                        <td id="@($"login-provider-{login.LoginProvider}")" class="tw:px-4 tw:py-3 tw:text-sm tw:text-slate-700">@login.ProviderDisplayName</td>
                        <td class="tw:px-4 tw:py-3 tw:text-right">
                            @if (Model.ShowRemoveButton)
                            {
                                <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="@btnPrimary" title="Remove this @login.ProviderDisplayName login from your account">Remove</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (Model.OtherLogins?.Count > 0)
{
    <h4 class="tw:mb-3 tw:text-sm tw:font-semibold tw:text-slate-900">Add another service to log in.</h4>
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
        <div id="socialLoginList" class="tw:flex tw:flex-wrap tw:gap-2">
            @foreach (var provider in Model.OtherLogins)
            {
                <button id="@($"link-login-button-{provider.Name}")" type="submit" class="@btnPrimary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
            }
        </div>
    </form>
}
