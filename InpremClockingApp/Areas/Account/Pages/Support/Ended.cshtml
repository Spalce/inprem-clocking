@page "/Account/Support/Ended"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Support session ended";
}

<div class="tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-8 tw:shadow-sm">
    <h1 class="tw:mb-2 tw:text-center tw:text-lg tw:font-semibold tw:text-slate-900">Support session ended</h1>
    <p class="tw:text-center tw:text-sm tw:text-slate-600" data-testid="ended">The support session is over and you are signed out of this organization. Return to the Provider Console to continue.</p>
</div>
