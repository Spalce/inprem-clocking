@page "/Account/ChooseOrganization"
@model ChooseOrganizationModel

@{
    ViewData["Title"] = "Choose organization";

    var btnOption = "tw:flex tw:w-full tw:cursor-pointer tw:items-center tw:justify-between tw:rounded-md tw:border tw:border-slate-300 tw:bg-white tw:px-4 tw:py-3 tw:text-left tw:text-sm tw:font-medium tw:text-slate-900 tw:hover:border-blue-500 tw:hover:bg-blue-50";
}

<div class="tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-8 tw:shadow-sm">
    <h1 class="tw:mb-2 tw:text-center tw:text-lg tw:font-semibold tw:text-slate-900">Choose organization</h1>
    <p class="tw:mb-6 tw:text-center tw:text-sm tw:text-slate-600">You belong to more than one organization. Which one do you want to work in?</p>

    <ul class="tw:space-y-3" data-testid="organizations">
        @foreach (var membership in Model.Memberships)
        {
            <li>
                <form method="post">
                    <input type="hidden" name="membershipId" value="@membership.MembershipId" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <button type="submit" class="@btnOption">
                        <span>@membership.TenantName</span>
                        <span class="tw:text-xs tw:font-normal tw:text-slate-500">@membership.Role</span>
                    </button>
                </form>
            </li>
        }
    </ul>

    <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="tw:mt-6 tw:text-center">
        <button type="submit" class="tw:cursor-pointer tw:border-0 tw:bg-transparent tw:text-sm tw:text-blue-600 tw:hover:underline">Sign out</button>
    </form>
</div>
