@page "/Account/SmsSignIn"
@model SmsSignInModel
@{
    ViewData["Title"] = "Sign-in code";

    var label = "tw:mb-1 tw:block tw:text-sm tw:font-medium tw:text-slate-700";
    var input = "tw:mb-4 tw:block tw:w-full tw:rounded-md tw:border tw:border-slate-300 tw:px-3 tw:py-2 tw:text-sm tw:focus:border-blue-500 tw:focus:outline-none tw:focus:ring-1 tw:focus:ring-blue-500";
    var button = "tw:inline-flex tw:w-full tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
}

<div class="tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-8 tw:shadow-sm">
    <h1 class="tw:mb-2 tw:text-center tw:text-lg tw:font-semibold tw:text-slate-900">Sign-in code</h1>
    <p class="tw:mb-6 tw:text-center tw:text-sm tw:text-slate-600">
        Your organization asks for a code by text after your password.
        @(Model.Confirmed != null ? $"We text it to {Model.Confirmed}." : "Add your mobile number first: we text the code to it.")
    </p>

    @if (Model.Error != null)
    {
        <div class="tw:mb-4 tw:text-sm tw:text-red-600" data-testid="error">@Model.Error</div>
    }
    @if (Model.Message != null)
    {
        <div class="tw:mb-4 tw:rounded-md tw:bg-emerald-50 tw:px-3 tw:py-2 tw:text-sm tw:text-emerald-700" data-testid="message">@Model.Message</div>
    }
    @if (Model.IsStandIn)
    {
        <p class="tw:mb-4 tw:text-xs tw:text-slate-500" data-testid="stand-in">Texts are not set up yet (stand-in): codes are saved on the server instead of being texted.</p>
    }

    @if (Model.CodeSent)
    {
        <form method="post" autocomplete="off">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" name="Phone" value="@Model.Phone" />
            <label for="Code" class="@label">Code from the text</label>
            <input id="Code" name="Code" inputmode="numeric" autocomplete="one-time-code" class="@input" required />
            <button type="submit" class="@button" data-testid="sign-in">Continue</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Send">
            <input type="hidden" asp-for="ReturnUrl" />
            @if (Model.Confirmed == null)
            {
                <label for="Phone" class="@label">Mobile number</label>
                <input id="Phone" name="Phone" type="tel" value="@Model.Phone" placeholder="+1 202 555 0123" class="@input" required />
            }
            <button type="submit" class="@button" data-testid="send">Text me a code</button>
        </form>
    }

    <p class="tw:mt-6 tw:text-center tw:text-sm">
        <a href="~/Identity/Account/Logout" class="tw:text-blue-600 tw:hover:underline">Sign out</a>
    </p>
</div>
