@page
@model OneVolunteerClockingReport
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Volunteer Clocking Report";
}

<!-- BoldReports removed: render individual volunteer clocking as HTML table -->

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Individual Volunteer Clocking Report</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Individual Volunteer Clocking Report</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                    <div style="width:100%;">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Clock In</th>
                                    <th>Clock Out</th>
                                    <th>Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var r in Model.ReportRows)
                                {
                                    var item = r.Clocking?.FirstOrDefault();
                                    <tr>
                                        <td>@(item?.CreatedAt?.ToString("yyyy-MM-dd") ?? "")</td>
                                        <td>@(item?.ClockInTime?.ToString("HH:mm:ss") ?? "")</td>
                                        <td>@(item?.ClockOutTime?.ToString("HH:mm:ss") ?? "")</td>
                                        <td>@(item?.WorkingHours?.ToString() ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
     $(function () {
         $("#viewer").boldReportViewer({
             reportServiceUrl: "/api/ReportViewer",
             reportPath: 'VolunteerClockingOne.rdl',
             parameters: [
                { name: 'Url', labels: ['Url'], values: ['http://app.inpremclockin.org/api/reports/volunteer-clocking-one'] },
                { name: 'VolUrl', labels: ['VolUrl'], values: ['http://app.inpremclockin.org/api/staff/all-volunteer'] },
                { name: 'Title', labels: ['Title'], values: ['Individual Volunteer Clocking Report'] },
                { name: 'StartDate', labels: ['Start Date'], values: ['2022-01-01'] },
                { name: 'EndDate', labels: ['End Date'], values: ['2022-12-31'] },
                { name: 'Image', labels: ['Image'], values: ['http://app.inpremclockin.org/img/inprem.png'] },
             ]
         });
     });
</script>
