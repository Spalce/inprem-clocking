@page
@model VolunteerAttendance
@using Microsoft.AspNetCore.Authorization;
@using InpremClockingApp.Models;
@attribute [Authorize]
@{
    Layout = "Shared/_MainLayout";
    ViewData["Title"] = "Volunteer Clocking";
}


<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0">Volunteer Clocking</h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">Volunteer Clocking</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <div class="content">
      <div class="container-fluid">
          <p class="text-danger">If you need your hours verified please send an email to inpremcc@gmail.com. Provide your full name,
              email used for registration and dates</p>
          <div class="row">
              <div class="col-md-6">
                  <div class="card card-primary card-outline">
                      <div class="card-header">
                          <h5 class="m-0">New Volunteer</h5>
                      </div>
                      <div class="card-body">
                          @if (TempData["Message"] != null)
                          {
                              <div class="alert alert-success">@TempData["Message"]</div>
                          }

                          <form id="registerForm" method="post" class="form-row">
                              <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                              <div class="col-md-6">
                                  <div class="form-floating">
                                      <label asp-for="Input!.FirstName" class="small"></label>
                                      <input asp-for="Input!.FirstName" class="form-control form-control-sm" autocomplete="first name" aria-required="true"/>
                                      <span asp-validation-for="Input!.FirstName" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6">
                                  <div class="form-floating">
                                      <label asp-for="Input!.LastName" class="small"></label>
                                      <input asp-for="Input!.LastName" class="form-control form-control-sm" autocomplete="user name" aria-required="true"/>
                                      <span asp-validation-for="Input!.LastName" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6">
                                  <div class="form-floating">
                                      <label asp-for="Input!.EmailAddress" class="small"></label>
                                      <input asp-for="Input!.EmailAddress" class="form-control form-control-sm" autocomplete="email" aria-required="true"/>
                                      <span asp-validation-for="Input!.EmailAddress" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6">
                                  <div class="form-floating">
                                      <label asp-for="Input!.ZipCode" class="small"></label>
                                      <input asp-for="Input!.ZipCode" class="form-control form-control-sm" autocomplete="zip code" aria-required="true"/>
                                      <span asp-validation-for="Input!.ZipCode" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6">
                                  <div class="form-floating">
                                      <label asp-for="Input!.PhoneNumber" class="small"></label>
                                      <input asp-for="Input!.PhoneNumber" class="form-control form-control-sm" autocomplete="phone number" aria-required="true"/>
                                      <span asp-validation-for="Input!.PhoneNumber" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6">
                                  <div class="form-floating">
                                      <label asp-for="Input!.Gender" class="small"></label>
                                      <select asp-for="Input!.Gender" class="form-control form-control-sm" placeholder="Gender">
                                          <option value=''>Gender</option>
                                          <option value='M'>Male</option>
                                          <option value='F'>Female</option>
                                      </select>
                                      <span asp-validation-for="Input!.Gender" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-12">
                                  <div class="form-floating">
                                      <label asp-for="Input!.VolunteerCategory" class="small">Which volunteer category do you fall under?</label>
                                      <select asp-for="Input!.VolunteerCategory" class="form-control form-control-sm" required>
                                          <option value="">-- Select category --</option>
                                          <option value="@VolunteerCategories.MandatedCommunityHours">Mandated Community Hours</option>
                                          <option value="@VolunteerCategories.MofcVolunteerHub">MOFC Volunteer Hub</option>
                                          <option value="@VolunteerCategories.EducationalPurposes">Educational Purposes</option>
                                          <option value="@VolunteerCategories.CorporateVolunteering">Corporate Volunteering</option>
                                          <option value="@VolunteerCategories.PersonalOrIndividualVolunteering">Personal or Individual Volunteering</option>
                                      </select>
                                      <span asp-validation-for="Input!.VolunteerCategory" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-12" id="mandateTypeGroup" style="display:none;">
                                  <div class="form-floating">
                                      <label asp-for="Input!.MandateType" class="small">Which of these applies to you?</label>
                                      <select asp-for="Input!.MandateType" class="form-control form-control-sm">
                                          <option value="">-- Select --</option>
                                          <option value="@VolunteerMandateTypes.CourtOrders">Court orders</option>
                                          <option value="@VolunteerMandateTypes.Diversion">Diversion</option>
                                          <option value="@VolunteerMandateTypes.YouthDetention">Youth Detention</option>
                                      </select>
                                      <span asp-validation-for="Input!.MandateType" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6" id="institutionGroup" style="display:none;">
                                  <div class="form-floating">
                                      <label asp-for="Input!.InstitutionName" class="small"></label>
                                      <input asp-for="Input!.InstitutionName" class="form-control form-control-sm" />
                                      <span asp-validation-for="Input!.InstitutionName" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6" id="placeOfWorkGroup" style="display:none;">
                                  <div class="form-floating">
                                      <label asp-for="Input!.PlaceOfWork" class="small"></label>
                                      <input asp-for="Input!.PlaceOfWork" class="form-control form-control-sm" />
                                      <span asp-validation-for="Input!.PlaceOfWork" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-6" id="contactPersonGroup" style="display:none;">
                                  <div class="form-floating">
                                      <label asp-for="Input!.ContactPerson" class="small"></label>
                                      <input asp-for="Input!.ContactPerson" class="form-control form-control-sm" />
                                      <span asp-validation-for="Input!.ContactPerson" class="text-danger small"></span>
                                  </div>
                              </div>
                              <div class="col-md-12" style="margin-top: 20px;">
                                  <button id="registerSubmit" type="submit" class="w-100 btn btn-sm btn-primary">Register</button>
                              </div>
                          </form>
                      </div>
                  </div>
              </div>
              <div class="col-md-6">
                  <div class="card card-danger card-outline">
                      <div class="card-header">
                          <h5 class="m-0">Existing Volunteer</h5>
                      </div>
                      <div class="card-body">
                          <form method="get">
                              <fieldset class="form-group">
                                  <div class="input-group col-xs-12">
                                        <input type="text" class="form-control" id="volunteerSearch" name="volunteerSearch" placeholder="Search Volunteer">
                                  </div>
                              </fieldset>
                          </form>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    // Show/hide the volunteer category's conditional follow-up fields, and only mark
    // them required while they're actually visible.
    (function () {
        var categorySelect = document.getElementById('Input_VolunteerCategory');
        var mandateGroup = document.getElementById('mandateTypeGroup');
        var mandateSelect = document.getElementById('Input_MandateType');
        var institutionGroup = document.getElementById('institutionGroup');
        var institutionInput = document.getElementById('Input_InstitutionName');
        var placeOfWorkGroup = document.getElementById('placeOfWorkGroup');
        var placeOfWorkInput = document.getElementById('Input_PlaceOfWork');
        var contactPersonGroup = document.getElementById('contactPersonGroup');
        var contactPersonInput = document.getElementById('Input_ContactPerson');

        var MANDATED = '@VolunteerCategories.MandatedCommunityHours';
        var EDUCATIONAL = '@VolunteerCategories.EducationalPurposes';
        var CORPORATE = '@VolunteerCategories.CorporateVolunteering';

        function setVisible(group, input, visible) {
            group.style.display = visible ? '' : 'none';
            input.required = visible;
            if (!visible) input.value = '';
        }

        function updateConditionalFields() {
            var value = categorySelect.value;
            setVisible(mandateGroup, mandateSelect, value === MANDATED);
            setVisible(institutionGroup, institutionInput, value === EDUCATIONAL);
            setVisible(placeOfWorkGroup, placeOfWorkInput, value === CORPORATE);
            setVisible(contactPersonGroup, contactPersonInput, value === EDUCATIONAL || value === CORPORATE);
        }

        categorySelect.addEventListener('change', updateConditionalFields);
        updateConditionalFields();
    })();

    $("#volunteerSearch").autocomplete({
      source: '/api/search/volunteer',
      autofocus: true,
      minLength: 2,
      select: function( event, ui ) {
        // do something with the selected item
        var selected = ui.item.value;
        $.ajax({
          url: '/api/search/volunteer-data/' + selected,
          dataType: "json",
          success: function( data ) {
              window.location.assign('/volunteer-clockin/' + data.volunteerId);
          }
        });
      },
    });
</script>

