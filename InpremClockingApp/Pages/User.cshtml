@page
@model User
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Admins";
}

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0">Admins (Total: @Model.Users?.Count() ?? 0)</h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">Admins</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <div class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-md-12">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>UserName</th>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Type</th>
                <th>Phone</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var u in Model.Users ?? Enumerable.Empty<InpremClockingApp.Models.Identity.AppUser>())
              {
                <tr>
                  <td>@u.UserName</td>
                  <td>@u.Email</td>
                  <td>@u.FirstName</td>
                  <td>@u.LastName</td>
                  <td>@u.Type</td>
                  <td>@u.PhoneNumber</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
