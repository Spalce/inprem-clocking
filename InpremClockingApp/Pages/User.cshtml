@page
@model User
@{
    ViewData["Title"] = "Admins";
}

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0">Admins (Total: @(ViewData["TotalCount"] ?? 0))</h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">Admins</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <div class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-md-12" style="margin-bottom: 30px;">
          <div class="card card-primary card-outline">
            <div class="card-header">
              <h5 class="m-0">Create Admin Account</h5>
            </div>
            <div class="card-body">
              @if (TempData["Message"] != null)
              {
                <div class="alert alert-success">@TempData["Message"]</div>
              }
              <div asp-validation-summary="All" class="text-danger"></div>
              <form method="post">
                <div class="row">
                  <div class="col-md-3">
                    <label asp-for="Input.FirstName">First Name</label>
                    <input asp-for="Input.FirstName" class="form-control" />
                  </div>
                  <div class="col-md-3">
                    <label asp-for="Input.LastName">Last Name</label>
                    <input asp-for="Input.LastName" class="form-control" />
                  </div>
                  <div class="col-md-3">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="form-control" />
                  </div>
                  <div class="col-md-2">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" class="form-control" />
                  </div>
                  <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Create</button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="col-md-12">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>UserName</th>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Type</th>
                <th>Phone</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var u in Model.Users ?? Enumerable.Empty<InpremClockingApp.Models.Identity.AppUser>())
              {
                <tr>
                  <td>@u.UserName</td>
                  <td>@u.Email</td>
                  <td>@u.FirstName</td>
                  <td>@u.LastName</td>
                  <td>@u.Type</td>
                  <td>@u.PhoneNumber</td>
                </tr>
              }
            </tbody>
          </table>

          <div class="d-flex justify-content-between align-items-center my-3">
            <div>
              <form id="pageSizeForm" method="get" class="form-inline">
                <label class="mr-2">Page size</label>
                @{ var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100; }
                <select name="pageSize" id="pageSizeSelect" class="form-control" onchange="document.getElementById('pageSizeForm').submit();">
                  <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
                  <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
                  <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
                  <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
                </select>
                <input type="hidden" name="pageNumber" value="1" />
              </form>
            </div>

            <nav aria-label="Page navigation">
              <ul class="pagination justify-content-center mb-0">
                @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                <li class="page-item @(current == 1 ? "disabled" : "")">
                  <a class="page-link" asp-page="./User" asp-route-pageNumber="@(current-1)" asp-route-pageSize="@size">Previous</a>
                </li>
                @for (int i = 1; i <= total; i++)
                {
                  <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./User" asp-route-pageNumber="@i" asp-route-pageSize="@size">@i</a></li>
                }
                <li class="page-item @(current == total ? "disabled" : "")">
                  <a class="page-link" asp-page="./User" asp-route-pageNumber="@(current+1)" asp-route-pageSize="@size">Next</a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
