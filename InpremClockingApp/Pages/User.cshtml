@page
@model User
@{
    ViewData["Title"] = "Admins";
    var input = "tw:w-full tw:rounded-md tw:border tw:border-slate-300 tw:px-3 tw:py-2 tw:text-sm tw:text-slate-900 tw:focus:border-blue-500 tw:focus:outline-none tw:focus:ring-1 tw:focus:ring-blue-500";
    var label = "tw:mb-1 tw:block tw:text-sm tw:font-medium tw:text-slate-700";
    var btnPrimary = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
}

<div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-6 tw:sm:px-6 tw:lg:px-8">
  <div class="tw:mb-6 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
    <h1 class="tw:text-2xl tw:font-semibold tw:text-slate-900">Admins (Total: @(ViewData["TotalCount"] ?? 0))</h1>
    <nav class="tw:text-sm tw:text-slate-500">
      <a href="#" class="tw:hover:text-slate-700">Home</a>
      <span class="tw:mx-1">/</span>
      <span class="tw:text-slate-700">Admins</span>
    </nav>
  </div>

  <div class="tw:mb-6 tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:shadow-sm">
    <div class="tw:border-b tw:border-slate-200 tw:px-4 tw:py-3">
      <h2 class="tw:text-sm tw:font-semibold tw:text-slate-900">Create Admin Account</h2>
    </div>
    <div class="tw:p-4">
      @if (TempData["Message"] != null)
      {
        <div class="tw:mb-3 tw:rounded-md tw:bg-emerald-50 tw:px-3 tw:py-2 tw:text-sm tw:text-emerald-700">@TempData["Message"]</div>
      }
      <div asp-validation-summary="All" class="tw:mb-3 tw:text-sm tw:text-red-600"></div>
      <form method="post">
        <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:sm:grid-cols-2 tw:lg:grid-cols-5 tw:lg:items-end">
          <div>
            <label asp-for="Input.FirstName" class="@label">First Name</label>
            <input asp-for="Input.FirstName" class="@input" />
          </div>
          <div>
            <label asp-for="Input.LastName" class="@label">Last Name</label>
            <input asp-for="Input.LastName" class="@input" />
          </div>
          <div>
            <label asp-for="Input.Email" class="@label">Email</label>
            <input asp-for="Input.Email" class="@input" />
          </div>
          <div>
            <label asp-for="Input.Password" class="@label">Password</label>
            <input asp-for="Input.Password" class="@input" />
          </div>
          <div>
            <button type="submit" class="@btnPrimary tw:w-full">Create</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white">
    <div class="tw:overflow-x-auto">
      <table class="tw:min-w-full tw:divide-y tw:divide-slate-200">
        <thead class="tw:bg-slate-50">
          <tr>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">UserName</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Email</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">First Name</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Last Name</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Type</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Phone</th>
          </tr>
        </thead>
        <tbody class="tw:divide-y tw:divide-slate-100">
          @foreach (var u in Model.Users ?? Enumerable.Empty<InpremClockingApp.Models.Identity.AppUser>())
          {
            <tr class="tw:hover:bg-slate-50">
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@u.UserName</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@u.Email</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@u.FirstName</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@u.LastName</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@u.Type</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@u.PhoneNumber</td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-3 tw:border-t tw:border-slate-200 tw:px-4 tw:py-3 tw:sm:flex-row tw:sm:items-center tw:sm:justify-between">
      <form id="pageSizeForm" method="get" class="tw:flex tw:items-center tw:gap-2">
        <label class="tw:text-sm tw:text-slate-600">Page size</label>
        @{ var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100; }
        <select name="pageSize" id="pageSizeSelect" class="tw:rounded-md tw:border tw:border-slate-300 tw:px-2 tw:py-1 tw:text-sm" onchange="document.getElementById('pageSizeForm').submit();">
          <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
          <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
          <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
          <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
        </select>
        <input type="hidden" name="pageNumber" value="1" />
      </form>

      <nav aria-label="Page navigation">
        <ul class="tw:flex tw:items-center tw:gap-1">
          @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
          <li>
            <a class="tw:rounded-md tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium @(current == 1 ? "tw:pointer-events-none tw:text-slate-300" : "tw:text-slate-600 tw:hover:bg-slate-100")" asp-page="./User" asp-route-pageNumber="@(current-1)" asp-route-pageSize="@size">Previous</a>
          </li>
          @for (int i = 1; i <= total; i++)
          {
            <li>
              <a class="tw:rounded-md tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium @(i == current ? "tw:bg-blue-600 tw:text-white" : "tw:text-slate-600 tw:hover:bg-slate-100")" asp-page="./User" asp-route-pageNumber="@i" asp-route-pageSize="@size">@i</a>
            </li>
          }
          <li>
            <a class="tw:rounded-md tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium @(current == total ? "tw:pointer-events-none tw:text-slate-300" : "tw:text-slate-600 tw:hover:bg-slate-100")" asp-page="./User" asp-route-pageNumber="@(current+1)" asp-route-pageSize="@size">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>
