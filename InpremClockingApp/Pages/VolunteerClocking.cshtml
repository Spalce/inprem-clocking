@page
@model VolunteerClocking
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Staff Clocking";
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Voulnteers Clocking</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Volunteers Clocking</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
      <div class="row">
          <div class="col-md-12" style="margin-bottom: 30px;">
                <div class="card card-primary card-outline">
                  <div class="card-header">
                    <h5 class="m-0">Manual Clocking Here</h5>
                  </div>
                  <div class="card-body">
                    <form asp-page="VolunteerClocking" method="post">
                          <div class="row">
                              <div class="col-md-6">
                                  <label for="volunteerSelect">Select Volunteer</label>
                                  <select id="volunteerSelect" name="ClockingVolunteer.VoluntId" class="form-control" required>
                                      <option value="">-- Select volunteer --</option>
                                      @foreach (var s in Model.Model.Volunteer ?? Enumerable.Empty<InpremClockingApp.Models.Volunteer>())
                                      {
                                          <option value="@s.VolunteerId">@s.FullName</option>
                                      }
                                  </select>
                              </div>
                              <div class="col-md-2">
                                  <label for="vclockIn">Clock In</label>
                                  <input id="vclockIn" name="ClockingVolunteer.ClockInTime" class="form-control" type="datetime-local" />
                              </div>
                              <div class="col-md-2">
                                  <label for="vclockOut">Clock Out</label>
                                  <input id="vclockOut" name="ClockingVolunteer.ClockOutTime" class="form-control" type="datetime-local" />
                              </div>
                              <div class="col-md-2 d-flex align-items-end">
                                  <button id="btnVClockIn" type="submit" class="btn btn-primary">Clock In</button>
                              </div>
                          </div>
                    </form>
                  </div>
                </div>
            </div>
          <div class="col-md-12">
              <div class="table-responsive">
                <div class="mb-3">
                  <input id="vsearchBox" class="form-control" placeholder="Search by name..." />
                </div>
                <table class="table table-striped" id="vclockingTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th>Break Start</th>
                            <th>Break End</th>
                            <th>Working</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Model?.Clocking ?? Enumerable.Empty<InpremClockingApp.Models.Clocking>())
                        {
                            <tr>
                                <td>@c.ClockingId</td>
                                <td>@c.FullName</td>
                                <td>@c.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                <td>@(c.ClockInTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.ClockOutTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.LeaveOnBreakTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.ReturnOnBreakTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.WorkingHours?.ToString() ?? "")</td>
                                <td>
                                    <button class="btn btn-sm btn-success" onclick="vpostAction('ClockOut', { ClockingId: @c.ClockingId })">Clock Out</button>
                                    <button class="btn btn-sm btn-warning" onclick="vpostAction('BreakStart', { ClockingId: @c.ClockingId })">Break Start</button>
                                    <button class="btn btn-sm btn-info" onclick="vpostAction('BreakEnd', { ClockingId: @c.ClockingId })">Break End</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <nav aria-label="Page navigation">
                  <ul class="pagination justify-content-center">
                    @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                    <li class="page-item @(current == 1 ? "disabled" : "")">
                      <a class="page-link" href="?page=@(current-1)&pageSize=@size">Previous</a>
                    </li>
                    @for (int i = 1; i <= total; i++)
                    {
                        <li class="page-item @(i == current ? "active" : "")"><a class="page-link" href="?page=@i&pageSize=@size">@i</a></li>
                    }
                    <li class="page-item @(current == total ? "disabled" : "")">
                      <a class="page-link" href="?page=@(current+1)&pageSize=@size">Next</a>
                    </li>
                  </ul>
                </nav>
              </div>
          </div>
      </div>
  </div>
</div>
</div>

<script>

    async function vpostAction(action, data) {
        try {
            const res = await fetch(`?handler=${action}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                location.reload();
            } else {
                console.error('Action failed', await res.text());
                location.reload();
            }
        } catch (err) {
            console.error(err);
            location.reload();
        }
    }

    document.getElementById('vsearchBox').addEventListener('input', function (e) {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('#vclockingTable tbody tr').forEach(function (tr) {
            const name = tr.children[1].textContent.toLowerCase();
            tr.style.display = name.indexOf(q) === -1 ? 'none' : '';
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
        const now = new Date();
        const isoLocal = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0,16);
        if(document.getElementById('vclockIn')) document.getElementById('vclockIn').value = isoLocal;
    });

</script>
