@page
@model ReportDesigner

@{
    Layout = "Shared/_Designer";
}

<div style="position: absolute; height: 100%; width: 100%;">
  <!-- Report designer removed. Provide a simple file upload UI to upload RDL files for server-side processing. -->
  <form method="post" enctype="multipart/form-data" asp-controller="ReportingApi" asp-action="UploadReportAction">
    <div class="form-group m-3">
      <label for="reportFile">Upload report (RDL)</label>
      <input type="file" name="file" id="reportFile" class="form-control" />
    </div>
    <div class="m-3">
      <button type="submit" class="btn btn-primary">Upload</button>
    </div>
  </form>
</div>
