@using InpremClockingApp.Models
<script>
    // Shared by Volunteer.cshtml and VolunteerDetails.cshtml alongside _VolunteerEditorModal -
    // not wrapped in an IIFE so both pages' own scripts can call openEditor(...) directly. Must
    // be included after the modal markup (these elements must already exist) and before each
    // page's own script.
    var MANDATED = '@VolunteerCategories.MandatedCommunityHours';
    var EDUCATIONAL = '@VolunteerCategories.EducationalPurposes';
    var CORPORATE = '@VolunteerCategories.CorporateVolunteering';

    function setConditionalVisible(group, input, visible) {
        group.style.display = visible ? '' : 'none';
        if (!visible) input.value = '';
    }

    function updateVolunteerConditionalFields() {
        var value = document.getElementById('vVolunteerCategory').value;
        setConditionalVisible(document.getElementById('vMandateTypeGroup'), document.getElementById('vMandateType'), value === MANDATED);
        setConditionalVisible(document.getElementById('vInstitutionGroup'), document.getElementById('vInstitutionName'), value === EDUCATIONAL);
        setConditionalVisible(document.getElementById('vPlaceOfWorkGroup'), document.getElementById('vPlaceOfWork'), value === CORPORATE);
        // Position/email/phone are only collected for Educational Purposes, unlike the contact
        // person's name above which is also asked for Corporate Volunteering.
        setConditionalVisible(document.getElementById('vContactPersonGroup'), document.getElementById('vContactPerson'), value === EDUCATIONAL || value === CORPORATE);
        setConditionalVisible(document.getElementById('vContactPersonPositionGroup'), document.getElementById('vContactPersonPosition'), value === EDUCATIONAL);
        setConditionalVisible(document.getElementById('vContactPersonEmailGroup'), document.getElementById('vContactPersonEmail'), value === EDUCATIONAL);
        setConditionalVisible(document.getElementById('vContactPersonPhoneGroup'), document.getElementById('vContactPersonPhone'), value === EDUCATIONAL);
    }

    document.getElementById('vVolunteerCategory').addEventListener('change', updateVolunteerConditionalFields);

    function clearEditorErrors() {
        document.getElementById('veditorErrors').innerHTML = '';
    }

    function showEditorErrors(obj) {
        var container = document.getElementById('veditorErrors');
        container.innerHTML = '';
        if (obj && obj.errors) {
            Object.keys(obj.errors).forEach(function (key) {
                var p = document.createElement('div');
                p.className = 'tw:text-sm tw:text-red-600';
                p.innerText = key + ': ' + obj.errors[key].join('; ');
                container.appendChild(p);
            });
        } else {
            var p = document.createElement('div');
            p.className = 'tw:text-sm tw:text-red-600';
            p.innerText = obj && obj.error ? obj.error : 'Request failed.';
            container.appendChild(p);
        }
    }

    // Opens in a new tab (not the same one) so clicking a match to check it doesn't discard
    // whatever the admin has already typed into the still-open Add New form. The trailing icon
    // signals that up front, since a link quietly opening elsewhere can otherwise be surprising.
    function nameMatchLink(m) {
        var a = document.createElement('a');
        a.href = '/VolunteerDetails?id=' + m.id;
        a.target = '_blank';
        a.rel = 'noopener';
        a.title = 'Opens in a new tab';
        a.appendChild(document.createTextNode(m.name + ' (' + m.email + ') '));
        var icon = document.createElement('i');
        icon.className = 'fas fa-external-link-alt tw:text-xs';
        a.appendChild(icon);
        return a;
    }

    function nameConflictButtons(onConfirm, onCancel) {
        var row = document.createElement('div');
        row.className = 'tw:flex tw:gap-2';

        var proceedBtn = document.createElement('button');
        proceedBtn.type = 'button';
        proceedBtn.className = 'tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700';
        proceedBtn.textContent = "This is a different person - Create Anyway";
        proceedBtn.addEventListener('click', onConfirm);

        var cancelBtn = document.createElement('button');
        cancelBtn.type = 'button';
        cancelBtn.className = 'tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-slate-700 tw:hover:bg-slate-50';
        cancelBtn.textContent = 'Cancel';
        cancelBtn.addEventListener('click', onCancel);

        row.appendChild(proceedBtn);
        row.appendChild(cancelBtn);
        return row;
    }

    // Builds (or rebuilds) the picker modal used for the multi-match case - not pre-rendered in
    // _VolunteerEditorModal since it's only ever needed here, triggered by a 409 response.
    function ensureNameConflictModal() {
        var existing = document.getElementById('vNameConflictModal');
        if (existing) existing.remove();

        var root = document.createElement('div');
        root.id = 'vNameConflictModal';
        root.setAttribute('data-modal-root', '');
        root.className = 'tw:fixed tw:inset-0 tw:z-50';

        var backdrop = document.createElement('div');
        backdrop.className = 'tw:fixed tw:inset-0 tw:bg-black/50';
        backdrop.setAttribute('data-modal-dismiss', 'vNameConflictModal');

        var wrap = document.createElement('div');
        wrap.className = 'tw:pointer-events-none tw:fixed tw:inset-0 tw:flex tw:items-center tw:justify-center tw:p-4';

        var panel = document.createElement('div');
        panel.className = 'tw:pointer-events-auto tw:w-full tw:max-w-md tw:rounded-lg tw:bg-white tw:shadow-xl';

        var header = document.createElement('div');
        header.className = 'tw:border-b tw:border-slate-200 tw:px-4 tw:py-3';
        var h5 = document.createElement('h5');
        h5.className = 'tw:text-base tw:font-semibold tw:text-slate-900';
        h5.textContent = 'Possible Duplicate';
        header.appendChild(h5);

        var body = document.createElement('div');
        body.className = 'tw:p-4';

        var footer = document.createElement('div');
        footer.className = 'tw:border-t tw:border-slate-200 tw:px-4 tw:py-3';

        panel.appendChild(header);
        panel.appendChild(body);
        panel.appendChild(footer);
        wrap.appendChild(panel);
        root.appendChild(backdrop);
        root.appendChild(wrap);
        document.body.appendChild(root);

        return { body: body, footer: footer };
    }

    // Shown when OnPostCreateAsync responds 409 with { nameConflict, matches } - an admin isn't a
    // walk-up stranger, so (unlike the kiosk's version of this prompt) full name/email are shown
    // rather than masked, and each match links to its Details page so the admin can check it
    // before deciding. A single match stays as an inline banner; two or more use a picker modal.
    function showNameConflict(obj, onConfirm) {
        var firstName = document.getElementById('vFirstName').value;
        var lastName = document.getElementById('vLastName').value;

        if (obj.matches.length > 1) {
            var modal = ensureNameConflictModal();

            var intro = document.createElement('p');
            intro.className = 'tw:mb-3 tw:text-sm tw:text-slate-600';
            intro.textContent = 'Volunteers named ' + firstName + ' ' + lastName + ' already exist. Open a record to check it, or confirm this is a different person.';
            modal.body.appendChild(intro);

            var list = document.createElement('div');
            list.className = 'tw:flex tw:flex-col tw:gap-2';
            obj.matches.forEach(function (m) {
                var link = nameMatchLink(m);
                link.className = 'tw:block tw:rounded-md tw:border tw:border-slate-200 tw:px-3 tw:py-2 tw:text-sm tw:text-blue-600 tw:hover:bg-slate-50 tw:hover:underline';
                list.appendChild(link);
            });
            modal.body.appendChild(list);

            modal.footer.appendChild(nameConflictButtons(
                function () { closeModal('vNameConflictModal'); onConfirm(); },
                function () { closeModal('vNameConflictModal'); }
            ));

            openModal('vNameConflictModal');
            return;
        }

        var container = document.getElementById('veditorErrors');
        container.innerHTML = '';

        var box = document.createElement('div');
        box.className = 'tw:mb-2 tw:rounded-md tw:bg-amber-50 tw:p-3';

        var intro = document.createElement('p');
        intro.className = 'tw:mb-2 tw:text-sm tw:text-amber-800';
        intro.appendChild(document.createTextNode('A volunteer named '));
        var link = nameMatchLink(obj.matches[0]);
        link.className = 'tw:font-semibold tw:text-amber-900 tw:underline';
        intro.appendChild(link);
        intro.appendChild(document.createTextNode(' already exists. Is this a different person?'));
        box.appendChild(intro);

        box.appendChild(nameConflictButtons(onConfirm, function () { container.innerHTML = ''; }));
        container.appendChild(box);
    }

    function setModalTitle(text) {
        document.getElementById('veditorModalTitle').innerText = text;
    }

    function openEditor(payload) {
        document.getElementById('VolunteerId').value = payload.VolunteerId || '';
        document.getElementById('vFirstName').value = payload.FirstName || '';
        document.getElementById('vLastName').value = payload.LastName || '';
        document.getElementById('vEmailAddress').value = payload.EmailAddress || '';
        document.getElementById('vGender').value = payload.Gender || 'M';
        document.getElementById('vPhoneNumber').value = payload.PhoneNumber || '';
        document.getElementById('vZipCode').value = payload.ZipCode || '';
        document.getElementById('vAddress').value = payload.Address || '';
        document.getElementById('vVolunteerCategory').value = payload.VolunteerCategory || '';
        updateVolunteerConditionalFields();
        document.getElementById('vMandateType').value = payload.MandateType || '';
        document.getElementById('vInstitutionName').value = payload.InstitutionName || '';
        document.getElementById('vPlaceOfWork').value = payload.PlaceOfWork || '';
        document.getElementById('vContactPerson').value = payload.ContactPerson || '';
        document.getElementById('vContactPersonPosition').value = payload.ContactPersonPosition || '';
        document.getElementById('vContactPersonEmail').value = payload.ContactPersonEmail || '';
        document.getElementById('vContactPersonPhone').value = payload.ContactPersonPhone || '';
        clearEditorErrors();
        setModalTitle(payload.VolunteerId ? 'Edit Volunteer' : 'New Volunteer');
        openModal('veditorModal');
    }

    function saveVolunteer(confirmDifferentPerson) {
        clearEditorErrors();
        var id = document.getElementById('VolunteerId').value;
        var payload = {
            VolunteerId: id ? parseInt(id) : 0,
            FirstName: document.getElementById('vFirstName').value,
            LastName: document.getElementById('vLastName').value,
            EmailAddress: document.getElementById('vEmailAddress').value,
            Gender: document.getElementById('vGender').value,
            PhoneNumber: document.getElementById('vPhoneNumber').value,
            ZipCode: document.getElementById('vZipCode').value,
            Address: document.getElementById('vAddress').value,
            VolunteerCategory: document.getElementById('vVolunteerCategory').value,
            MandateType: document.getElementById('vMandateType').value,
            InstitutionName: document.getElementById('vInstitutionName').value,
            PlaceOfWork: document.getElementById('vPlaceOfWork').value,
            ContactPerson: document.getElementById('vContactPerson').value,
            ContactPersonPosition: document.getElementById('vContactPersonPosition').value,
            ContactPersonEmail: document.getElementById('vContactPersonEmail').value,
            ContactPersonPhone: document.getElementById('vContactPersonPhone').value
        };

        // Absolute path - this script runs from both /Volunteer and /VolunteerDetails.
        var url = (id ? '/Volunteer?handler=Update' : '/Volunteer?handler=Create') +
            (confirmDifferentPerson ? '&confirmDifferentPerson=true' : '');

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        }).then(function (response) {
            if (response.ok || response.redirected) {
                closeModal('veditorModal');
                location.reload();
                return;
            }
            return response.json().then(function (json) {
                if (response.status === 409 && json && json.nameConflict) {
                    showNameConflict(json, function () { saveVolunteer(true); });
                } else {
                    showEditorErrors(json);
                }
            });
        }).catch(function () { showEditorErrors({ error: 'Request failed.' }); });
    }

    document.getElementById('vbtnSave').addEventListener('click', function () { saveVolunteer(false); });
</script>
