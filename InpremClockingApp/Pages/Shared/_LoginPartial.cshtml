@using InpremClockingApp.Models.Identity;
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div class="tw:flex tw:items-center tw:gap-4">
@if (SignInManager.IsSignedIn(User))
{
    <a class="tw:text-sm tw:font-medium tw:text-slate-600 tw:hover:text-slate-900" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" method="post">
        <button type="submit" class="tw:cursor-pointer tw:border-0 tw:bg-transparent tw:p-0 tw:text-sm tw:font-medium tw:text-slate-600 tw:hover:text-slate-900">Logout</button>
    </form>
}
else
{
    <a class="tw:text-sm tw:font-medium tw:text-slate-600 tw:hover:text-slate-900" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
</div>
