<header class="tw:sticky tw:top-0 tw:z-20 tw:flex tw:h-16 tw:items-center tw:justify-between tw:border-b tw:border-slate-200 tw:bg-white tw:px-4 tw:sm:px-6">
  <div class="tw:flex tw:items-center tw:gap-4">
    <button type="button" data-sidebar-open class="tw:cursor-pointer tw:appearance-none tw:border-0 tw:bg-transparent tw:p-0 tw:text-slate-500 tw:hover:text-slate-700 tw:lg:hidden">
      <i class="fas fa-bars"></i>
    </button>
  </div>

  <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" method="post">
    <button type="submit" class="tw:cursor-pointer tw:border-0 tw:bg-transparent tw:p-0 tw:text-sm tw:font-medium tw:text-slate-600 tw:hover:text-slate-900">Logout</button>
  </form>
</header>
