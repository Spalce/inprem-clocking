<script>
    // Shared by Staff.cshtml and StaffDetails.cshtml alongside _StaffEditorModal - not wrapped
    // in an IIFE so both pages' own scripts can call openEditor(...) directly. Must be included
    // after the modal markup (these elements must already exist) and before each page's own
    // script.
    function clearEditorErrors() {
        document.getElementById('editorErrors').innerHTML = '';
    }

    function showEditorErrors(obj) {
        var container = document.getElementById('editorErrors');
        container.innerHTML = '';
        if (obj && obj.errors) {
            Object.keys(obj.errors).forEach(function (key) {
                var p = document.createElement('div');
                p.className = 'tw:text-sm tw:text-red-600';
                p.innerText = key + ': ' + obj.errors[key].join('; ');
                container.appendChild(p);
            });
        } else {
            var p = document.createElement('div');
            p.className = 'tw:text-sm tw:text-red-600';
            p.innerText = obj && obj.error ? obj.error : 'Request failed.';
            container.appendChild(p);
        }
    }

    function setModalTitle(text) {
        document.getElementById('editorModalTitle').innerText = text;
    }

    function openEditor(payload) {
        document.getElementById('StaffId').value = payload.StaffId || '';
        document.getElementById('FirstName').value = payload.FirstName || '';
        document.getElementById('LastName').value = payload.LastName || '';
        document.getElementById('EmailAddress').value = payload.EmailAddress || '';
        document.getElementById('Gender').value = payload.Gender || 'M';
        document.getElementById('PhoneNumber').value = payload.PhoneNumber || '';
        document.getElementById('ZipCode').value = payload.ZipCode || '';
        document.getElementById('Address').value = payload.Address || '';
        clearEditorErrors();
        setModalTitle(payload.StaffId ? 'Edit Staff' : 'New Staff');
        openModal('editorModal');
    }

    document.getElementById('btnSave').addEventListener('click', function () {
        clearEditorErrors();
        var id = document.getElementById('StaffId').value;
        var payload = {
            StaffId: id ? parseInt(id) : 0,
            FirstName: document.getElementById('FirstName').value,
            LastName: document.getElementById('LastName').value,
            EmailAddress: document.getElementById('EmailAddress').value,
            Gender: document.getElementById('Gender').value,
            PhoneNumber: document.getElementById('PhoneNumber').value,
            ZipCode: document.getElementById('ZipCode').value,
            Address: document.getElementById('Address').value
        };

        // Absolute path - this script runs from both /Staff and /StaffDetails.
        fetch(id ? '/Staff?handler=Update' : '/Staff?handler=Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        }).then(function (response) {
            if (response.ok || response.redirected) {
                closeModal('editorModal');
                location.reload();
                return;
            }
            return response.json().then(function (json) { throw json; });
        }).catch(showEditorErrors);
    });
</script>
