<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] - Inprem Clockin App</title>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css">
  <!-- Material Icons (used by showToast() below) -->
  <link href="https://fonts.googleapis.com/css?family=Material+Icons%7CMaterial+Icons+Outlined%7CMaterial+Icons+Two+Tone%7CMaterial+Icons+Round%7CMaterial+Icons+Sharp" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
  <link rel="stylesheet" href="~/InpremClockingApp.styles.css" asp-append-version="true"/>
  <!-- Tailwind CSS (all classes prefixed "tw:" for historical reasons - the prefix predates
       Bootstrap/AdminLTE's removal in Phase 4, see UI-modification.md) -->
  <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true"/>
  <script src="~/lib/jquery/jquery.min.js"></script>
</head>
<body class="tw:min-h-screen tw:bg-slate-50 tw:font-sans tw:text-slate-900 tw:antialiased">

<partial name="_Sidebar"/>

<div class="tw:flex tw:min-h-screen tw:min-w-0 tw:flex-col tw:lg:pl-64">
  <partial name="_Topmenu"/>

  <div class="tw:w-full tw:min-w-0">
    @RenderBody()
  </div>

  <partial name="_Footer"/>
</div>

<script src="~/js/layout.js" asp-append-version="true"></script>
<script >
	function showToast(text, duration, alertInfo) {
		var alerts = $(".alerts"),
			body = $("body"),
			alertClass = "",
			alertIco = "info";

		if (!alerts.length) {
			body.append('<div class="alerts"></div>');
		}
		$(".alert").remove();

		if (alertInfo === "success") {
			alertClass = "alert-success";
			alertIco = "check";
		} else if (alertInfo === "danger") {
			alertClass = "alert-danger";
			alertIco = "error";
		} else if (alertInfo === "warning") {
			alertClass = "alert-warning";
			alertIco = "warning";
		} else if (alertInfo === "default") {
			alertClass = "alert-default";
			alertIco = "info";
		}

		if (!$("." + alertClass + "").length) {
			$(".alerts").append(
			'<div class="alert ' +
				alertClass +
				'" data-duration-hide="' +
				duration +
				'"> <div class="alert-ico"> <i class="material-icons md-22">' +
				alertIco +
				'</i> </div> <div class="alert-text">' +
				text +
				"</div> </div>"
			);

			setTimeout(function() {
				$("." + alertClass + "").remove();
			}, duration);
		}

		$(document).on("click", ".alert-close", function() {
			$(this)
			.closest(".alert")
			.remove();
		});
	}
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
