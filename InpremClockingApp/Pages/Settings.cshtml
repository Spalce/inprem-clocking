@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Settings
@{
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Logout Settings</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Logout Settings</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <form asp-page="Settings" method="post">
          <input type="hidden" asp-for="Model!.Id" />
          <div class="row">
            <div class="col-12">
                <div class="form-group">
                    <label asp-for="Model!.Name"></label>
                    <input readonly asp-for="Model!.Name" id="name" class="form-control" placeholder="Setting Type" />
                </div>
            </div>
            <div class="col-12">
                <div class="form-group">
                    <label asp-for="Model!.Duration"></label>
                    <input asp-for="Model!.Duration" id="duration" class="form-control" placeholder="Duration" />
                </div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Model!.Action" class="form-check-input" id="default" type="checkbox" checked />
                    <label class="form-check-label" for="default">Logout After Every Clocking</label>
                </div>
            </div>

            <div class="col-12" style="margin-top: 20px;">
              <button id="btnEjsOne" class="btn btn-outline-primary" type="submit"><i class="fa fa-plus"></i> Save</button>
            </div>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>
</div>
