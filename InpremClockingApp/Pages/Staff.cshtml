@page
@model Staff
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Staff List";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Staff List (Total: @Model.Staffs!.Count())</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Staff List</li>
                    </ol>
                </div>
            </div>
        </div>
        <div class="modal fade" id="hoursModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Staff Hours</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="hoursForm">
                            <input type="hidden" id="hStaffId" name="StaffId" />
                            <div class="form-group">
                                <label>Start</label>
                                <input type="date" id="hStart" name="Start" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>End</label>
                                <input type="date" id="hEnd" name="End" class="form-control" />
                            </div>
                            <div id="hoursResult" class="mt-3"></div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" id="btnDownloadPdf" class="btn btn-primary">Download PDF</button>
                        <button type="button" id="btnCalculate" class="btn btn-info">Calculate</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="d-flex justify-content-between mb-2">
                        <div style="flex:1">
                            <input id="emailSearch" placeholder="Search by email..." class="form-control" autocomplete="off" />
                            <div id="emailHint" class="small text-muted mt-1">Type to search emails</div>
                        </div>
                        <div class="ml-2">
                            <button id="btnAdd" class="btn btn-primary">Add New</button>
                        </div>
                    </div>

                    <table class="table table-striped" id="staffTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Gender</th>
                                <th>Phone</th>
                                <th>Zip</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Staffs ?? Enumerable.Empty<InpremClockingApp.Models.Staff>())
                            {
                                <tr data-id="@s.StaffId" data-address="@s.Address" data-created-at="@s.CreatedAt?.ToString("O")">
                                    <td>@s.StaffId</td>
                                    <td>@s.FirstName</td>
                                    <td>@s.LastName</td>
                                    <td>@s.EmailAddress</td>
                                    <td>@s.Gender</td>
                                    <td>@s.PhoneNumber</td>
                                    <td>@s.ZipCode</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-edit">Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-info btn-move">Move To Volunteer</button>
                                        @* <button type="button" class="btn btn-sm btn-outline-primary btn-hours">Hours</button> *@
                                        <a href="/HoursWorked?type=staff&id=@s.StaffId"
                                           class="btn btn-sm btn-outline-primary">
                                            Hours
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="modal fade" id="editorModal" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Edit Staff</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <div id="editorErrors"></div>
                                    <form id="editorForm">
                                        <input type="hidden" name="StaffId" id="StaffId" />
                                        <div class="form-group">
                                            <label>First Name</label>
                                            <input class="form-control" name="FirstName" id="FirstName" />
                                        </div>
                                        <div class="form-group">
                                            <label>Last Name</label>
                                            <input class="form-control" name="LastName" id="LastName" />
                                        </div>
                                        <div class="form-group">
                                            <label>Email</label>
                                            <input class="form-control" name="EmailAddress" id="EmailAddress" />
                                        </div>
                                        <div class="form-group">
                                            <label>Gender</label>
                                            <select class="form-control" name="Gender" id="Gender">
                                                <option value="M">M</option>
                                                <option value="F">F</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label>Phone</label>
                                            <input class="form-control" name="PhoneNumber" id="PhoneNumber" />
                                        </div>
                                        <div class="form-group">
                                            <label>Zip</label>
                                            <input class="form-control" name="ZipCode" id="ZipCode" />
                                        </div>
                                        <div class="form-group">
                                            <label>Address</label>
                                            <textarea class="form-control" name="Address" id="Address"></textarea>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                    <button type="button" id="btnSave" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var table = document.getElementById('staffTable');
        var searchInput = document.getElementById('emailSearch');
        var hint = document.getElementById('emailHint');
        var timer = null;

        function rowToPayload(tr) {
            return {
                StaffId: parseInt(tr.getAttribute('data-id') || '0'),
                FirstName: tr.children[1].innerText,
                LastName: tr.children[2].innerText,
                EmailAddress: tr.children[3].innerText,
                Gender: tr.children[4].innerText,
                PhoneNumber: tr.children[5].innerText,
                ZipCode: tr.children[6].innerText,
                Address: tr.getAttribute('data-address') || '',
                CreatedAt: tr.getAttribute('data-created-at') || null
            };
        }

        function clearEditorErrors() {
            document.getElementById('editorErrors').innerHTML = '';
        }

        function showEditorErrors(obj) {
            var container = document.getElementById('editorErrors');
            container.innerHTML = '';
            if (obj && obj.errors) {
                Object.keys(obj.errors).forEach(function (key) {
                    var p = document.createElement('div');
                    p.className = 'text-danger';
                    p.innerText = key + ': ' + obj.errors[key].join('; ');
                    container.appendChild(p);
                });
            } else {
                var p = document.createElement('div');
                p.className = 'text-danger';
                p.innerText = obj && obj.error ? obj.error : 'Request failed.';
                container.appendChild(p);
            }
        }

        function setModalTitle(text) {
            document.querySelector('#editorModal .modal-title').innerText = text;
        }

        function openEditor(payload) {
            document.getElementById('StaffId').value = payload.StaffId || '';
            document.getElementById('FirstName').value = payload.FirstName || '';
            document.getElementById('LastName').value = payload.LastName || '';
            document.getElementById('EmailAddress').value = payload.EmailAddress || '';
            document.getElementById('Gender').value = payload.Gender || 'M';
            document.getElementById('PhoneNumber').value = payload.PhoneNumber || '';
            document.getElementById('ZipCode').value = payload.ZipCode || '';
            document.getElementById('Address').value = payload.Address || '';
            clearEditorErrors();
            setModalTitle(payload.StaffId ? 'Edit Staff' : 'New Staff');
            $('#editorModal').modal('show');
        }

        function filterRows(value) {
            var term = value.toLowerCase();
            Array.prototype.forEach.call(table.tBodies[0].rows, function (row) {
                row.style.display = !term || row.children[3].innerText.toLowerCase().indexOf(term) !== -1 ? '' : 'none';
            });
        }

        function showHints(list) {
            hint.innerHTML = '';
            list.slice(0, 10).forEach(function (email) {
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'btn btn-link p-0 mr-2';
                button.textContent = email;
                button.addEventListener('click', function () {
                    searchInput.value = email;
                    filterRows(email);
                    hint.innerHTML = '';
                });
                hint.appendChild(button);
            });
        }

        table.addEventListener('click', function (event) {
            var tr = event.target.closest('tr');
            if (!tr) return;

            if (event.target.classList.contains('btn-edit')) {
                openEditor(rowToPayload(tr));
            }

            if (event.target.classList.contains('btn-move')) {
                if (!confirm('Move staff member to volunteers?')) return;
                fetch('?handler=Move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(rowToPayload(tr))
                }).then(function (response) {
                    if (response.ok || response.redirected) location.reload();
                    else return response.json().then(showEditorErrors);
                }).catch(function () {
                    showEditorErrors({ error: 'Move failed.' });
                });
            }
        });

        document.getElementById('btnAdd').addEventListener('click', function () {
            openEditor({ Gender: 'M' });
        });

        // Hours modal actions
        document.getElementById('btnCalculate').addEventListener('click', function () {
            var id = document.getElementById('hStaffId').value;
            var s = document.getElementById('hStart').value;
            var e = document.getElementById('hEnd').value;
            if (!id) return;
            fetch(`/api/people/staff-hours?id=${encodeURIComponent(id)}&start=${encodeURIComponent(s)}&end=${encodeURIComponent(e)}`)
                .then(r => r.json())
                .then(json => {
                    document.getElementById('hoursResult').innerHTML = `
                        <div class="mt-3">
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>Total Hours Clocked</span>
                                <strong>${json.totalClockedDisplay}</strong>
                            </div>

                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>Total Hours for Break</span>
                                <strong>${json.totalBreakDisplay}</strong>
                            </div>

                            <div class="d-flex justify-content-between py-2">
                                <span>Actual Hours Worked</span>
                                <strong>${json.actualWorkedDisplay}</strong>
                            </div>
                        </div>`;
                    
                    // store last result for PDF
                    document.getElementById('hoursResult').dataset.last = JSON.stringify(json);
                }).catch(()=> document.getElementById('hoursResult').innerHTML = '<div class="text-danger">Failed to calculate hours.</div>');
        });

        document.getElementById('btnDownloadPdf').addEventListener('click', function () {
            var data = document.getElementById('hoursResult').dataset.last;
            if (!data) {
                alert('Please calculate hours first');
                return;
            }
            var json = JSON.parse(data);
            // request server PDF generation endpoint
            fetch(`/api/people/staff-hours-pdf?id=${encodeURIComponent(json.staffId)}&start=${encodeURIComponent(json.start)}&end=${encodeURIComponent(json.end)}`)
                .then(function (res) { if (!res.ok) throw new Error('PDF failed'); return res.blob(); })
                .then(function (blob) { var url = URL.createObjectURL(blob); var a = document.createElement('a'); a.href = url; a.download = `staff-${json.staffId}-hours.pdf`; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url); })
                .catch(function () { alert('Failed to download PDF'); });
        });

            // Open Staff Hours modal
        document.addEventListener('click', function (event) {
            if (!event.target.classList.contains('btn-hours')) return;

            var tr = event.target.closest('tr');
            if (!tr) return;

            var staffId = tr.dataset.id;

            if (!staffId) {
                alert('Staff ID not found.');
                return;
            }

            document.getElementById('hStaffId').value = staffId;

            // Default dates: last 30 days
            var end = new Date();
            var start = new Date();
            start.setDate(end.getDate() - 30);

            document.getElementById('hStart').value =
                start.toISOString().slice(0, 10);

            document.getElementById('hEnd').value =
                end.toISOString().slice(0, 10);

            document.getElementById('hoursResult').innerHTML = '';

            $('#hoursModal').modal('show');
        });

        document.getElementById('btnSave').addEventListener('click', function () {
            clearEditorErrors();
            var id = document.getElementById('StaffId').value;
            var payload = {
                StaffId: id ? parseInt(id) : 0,
                FirstName: document.getElementById('FirstName').value,
                LastName: document.getElementById('LastName').value,
                EmailAddress: document.getElementById('EmailAddress').value,
                Gender: document.getElementById('Gender').value,
                PhoneNumber: document.getElementById('PhoneNumber').value,
                ZipCode: document.getElementById('ZipCode').value,
                Address: document.getElementById('Address').value
            };

            fetch(id ? '?handler=Update' : '?handler=Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(function (response) {
                if (response.ok || response.redirected) {
                    $('#editorModal').modal('hide');
                    location.reload();
                    return;
                }
                return response.json().then(function (json) { throw json; });
            }).catch(showEditorErrors);
        });

        searchInput.addEventListener('input', function () {
            var value = searchInput.value || '';
            filterRows(value);
            if (timer) clearTimeout(timer);
            timer = setTimeout(function () {
                if (!value) {
                    hint.innerText = 'Type to search emails';
                    return;
                }
                fetch('/api/people/emails?q=' + encodeURIComponent(value))
                    .then(function (response) { return response.ok ? response.json() : []; })
                    .then(showHints)
                    .catch(function () { hint.innerHTML = ''; });
            }, 250);
        });
    })();
</script>
