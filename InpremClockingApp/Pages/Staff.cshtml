@page
@model Staff
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Staff List";
}

@{
    List<object> commands = new List<object>();
    commands.Add(new { type = "None", title = "Move", buttonOption = new { content = "Move To Volunteer", cssClass = "e-flat e-details" } }); // custom
    // commands.Add(new { type = "Delete", title = "Delete", buttonOption = new { content = "Delete", cssClass = "e-flat e-deleted" } }); // custom
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Staff List (Total: @Model.Staffs!.Count())</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Staff List</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between mb-2">
                <div style="flex:1">
                    <input id="emailSearch" placeholder="Search by email..." class="form-control" autocomplete="off" />
                    <div id="emailHint" class="small text-muted mt-1">Type to search emails (autocomplete)</div>
                </div>
                <div class="ml-2">
                    <button id="btnAdd" class="btn btn-primary">Add New</button>
                </div>
            </div>

            <table class="table table-striped" id="staffTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Zip</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Staffs ?? Enumerable.Empty<InpremClockingApp.Models.Staff>())
                    {
                        <tr data-id="@s.StaffId">
                            <td>@s.StaffId</td>
                            <td>@s.FirstName</td>
                            <td>@s.LastName</td>
                            <td>@s.EmailAddress</td>
                            <td>@s.Gender</td>
                            <td>@s.PhoneNumber</td>
                            <td>@s.ZipCode</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary btn-edit">Edit</button>
                                <button class="btn btn-sm btn-outline-danger btn-delete">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Editor Modal -->
            <div class="modal fade" id="editorModal" tabindex="-1" role="dialog" aria-hidden="true">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title">Edit Staff</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">
                    <div id="editorErrors"></div>
                    <form id="editorForm">
                        <input type="hidden" name="StaffId" id="StaffId" />
                        <div class="form-group">
                            <label>First Name</label>
                            <input class="form-control" name="FirstName" id="FirstName" />
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input class="form-control" name="LastName" id="LastName" />
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input class="form-control" name="EmailAddress" id="EmailAddress" />
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select class="form-control" name="Gender" id="Gender">
                                <option value="M">M</option>
                                <option value="F">F</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input class="form-control" name="PhoneNumber" id="PhoneNumber" />
                        </div>
                        <div class="form-group">
                            <label>Zip</label>
                            <input class="form-control" name="ZipCode" id="ZipCode" />
                        </div>
                        <div class="form-group">
                            <label>Address</label>
                            <textarea class="form-control" name="Address" id="Address"></textarea>
                        </div>
                    </form>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" id="btnSave" class="btn btn-primary">Save</button>
                  </div>
                </div>
              </div>
            </div>
        </div>
    </div>
  </div>
</div>
</div>

<script>

    /*ej.base.L10n.load({
        'en-US': {
            'grid': {
                'SaveButton': 'Save',
                'CancelButton': 'Discard'
            }
        }
    });*/

    function actionBegin(args) {
        if (args.requestType === 'save') {
            // Client-side validation: ensure EmailAddress is present and looks like an email.
            var email = args.data['EmailAddress'];
            var emailRegex = /\S+@@\S+\.\S+/;
            var dialogContainer = document.querySelector('.e-dialog');
            clearValidationErrors(dialogContainer);
            if (!email || !emailRegex.test(email)) {
                // show inline validation in the editor dialog
                showValidationErrors(dialogContainer, { EmailAddress: ['Please enter a valid email address.'] });
                args.cancel = true; // prevent grid from continuing the save
                return;
            }
            // Ensure first/last names are not null to avoid DB NULL insert errors
            if (!args.data['FirstName']) args.data['FirstName'] = '';
            if (!args.data['LastName']) args.data['LastName'] = '';
            if (args.rowData['StaffId']) {
                $.ajax({
                   type: "POST",
                   url: "?handler=Update",
                   data: JSON.stringify(args.data),
                   contentType: "application/json; charset=utf-8",
                   dataType: "json",
                   processData: true,
                   success: function (data, status, jqXHR) {
                       // alert("success..." + data);
                   },
                   error: function (xhr) {
                       // alert(xhr.responseText);
                       document.location.reload(true);
                   }
               });
            } else {
                $.ajax({
                   type: "POST",
                   url: "?handler=Create",
                   data: JSON.stringify(args.data),
                   contentType: "application/json; charset=utf-8",
                   dataType: "json",
                   processData: true,
                   success: function (data, status, jqXHR) {
                       // success - nothing to display, grid will update
                   },
                   error: function (xhr) {
                       var container = document.querySelector('.e-dialog');
                       clearValidationErrors(container);
                       var json = null;
                       try { json = xhr.responseJSON || JSON.parse(xhr.responseText); } catch (e) { }
                       if (json) {
                           if (json.errors) showValidationErrors(container, json.errors);
                           else if (json.error) showGeneralError(container, json.error);
                           else showGeneralError(container, 'Server error: ' + xhr.statusText);
                       } else {
                           showGeneralError(container, 'Server error: ' + xhr.statusText);
                       }
                   }
               });
            }
        }

        if (args.requestType === 'delete') {
            $.ajax({
               type: "DELETE",
               url: "https://localhost:7094/api/staffs/" + args.data['StaffId'],
               data: JSON.stringify(args.data),
               contentType: "application/json; charset=utf-8",
               dataType: "json",
               processData: true,
               success: function (data, status, jqXHR) {
                   // alert("success..." + data);
               },
               error: function (xhr) {
                   // alert(xhr.responseText);
               }
           });
        }
    }

    function actionComplete(args) {
        if (args.requestType === 'beginEdit' || args.requestType === 'add') {
            var dialog = args.dialog;
            dialog.showCloseIcon = false;
            // dialog.height = 400;
            // change the header of the dialog
            dialog.header = args.requestType === 'beginEdit' ? 'Edit Record of ' + args.rowData['FirstName'] : 'New Staff';
        }
    }

    function commandClick(args) {
        if (args.target.title === 'Move') {
            console.log(JSON.stringify(args.rowData));
            $.ajax({
               type: "POST",
               url: "?handler=Move",
               data: JSON.stringify(args.rowData),
               contentType: "application/json; charset=utf-8",
               dataType: "json",
               processData: true,
               success: function (data, status, jqXHR) {
                   // alert("success...");
               },
               error: function (xhr) {
                   document.location.reload(true);
               }
           });
        }
    }

    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
        if (args.item.id === 'Grid_pdfexport') {
            gridObj.pdfExport();
        }
        if (args.item.id === 'Grid_excelexport') {
            gridObj.excelExport();
        }
    }

    // Debounced AJAX autocomplete for email search + grid filtering
    document.addEventListener('DOMContentLoaded', function () {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
        var input = document.getElementById('emailSearch');
        var timer = null;
        if (!input) return;

        input.addEventListener('input', function () {
            var val = this.value || '';
            if (timer) clearTimeout(timer);
            timer = setTimeout(function () {
                if (!val) {
                    if (gridObj) gridObj.clearFiltering();
                    return;
                }

                // Call API for suggestions
                fetch('/api/people/emails?q=' + encodeURIComponent(val))
                    .then(function (r) { return r.json(); })
                    .then(function (list) {
                        // If grid present, filter by entered value prefix
                        if (gridObj) {
                            try { gridObj.filterByColumn('EmailAddress', 'startswith', val.toString()); }
                            catch (e) { gridObj.search(val); }
                        }

                        // Show minimal suggestion dropdown (browser datalist-like)
                        var hint = document.getElementById('emailHint');
                        if (!hint) return;
                        hint.innerHTML = '';
                        list.slice(0,10).forEach(function (it) {
                            var btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn btn-link p-0';
                            btn.textContent = it;
                            btn.addEventListener('click', function () {
                                input.value = it;
                                input.dispatchEvent(new Event('input'));
                            });
                            hint.appendChild(btn);
                            hint.appendChild(document.createTextNode(' '));
                        });
                    }).catch(function () { /* ignore */ });
            }, 250);
        });
    });

    // Helper functions to show/clear validation UI in the Syncfusion dialog
    function clearValidationErrors(dialog) {
        if (!dialog) return;
        var list = dialog.querySelectorAll('.field-error');
        list.forEach(function (n) { n.parentNode.removeChild(n); });
        var gen = dialog.querySelector('.general-error');
        if (gen) gen.innerText = '';
    }

    function showValidationErrors(dialog, errors) {
        if (!dialog) return;
        // errors is { fieldName: [messages] }
        Object.keys(errors).forEach(function (field) {
            var input = dialog.querySelector('[name="' + field + '"]');
            var messages = errors[field];
            var container = input ? input.parentNode : dialog;
            var span = document.createElement('div');
            span.className = 'field-error text-danger small';
            span.innerText = messages.join('; ');
            container.appendChild(span);
        });
    }

    function showGeneralError(dialog, message) {
        if (!dialog) return;
        var gen = dialog.querySelector('.general-error');
        if (!gen) {
            gen = document.createElement('div');
            gen.className = 'general-error alert alert-danger mt-2';
            var header = dialog.querySelector('.e-dlg-content') || dialog;
            header.appendChild(gen);
        }
        gen.innerText = message;
    }

</script>
<script>
    // Client-side logic for table-based editor
    (function () {
        function buildRow(data) {
            return '<tr data-id="' + data.StaffId + '">'
                + '<td>' + data.StaffId + '</td>'
                + '<td>' + (data.FirstName || '') + '</td>'
                + '<td>' + (data.LastName || '') + '</td>'
                + '<td>' + (data.EmailAddress || '') + '</td>'
                + '<td>' + (data.Gender || '') + '</td>'
                + '<td>' + (data.PhoneNumber || '') + '</td>'
                + '<td>' + (data.ZipCode || '') + '</td>'
                + '<td><button class="btn btn-sm btn-outline-secondary btn-edit">Edit</button> <button class="btn btn-sm btn-outline-danger btn-delete">Delete</button></td>'
                + '</tr>';
        }

        function clearEditorErrors() {
            document.getElementById('editorErrors').innerHTML = '';
        }

        function showEditorErrors(obj) {
            var container = document.getElementById('editorErrors');
            container.innerHTML = '';
            if (obj.errors) {
                Object.keys(obj.errors).forEach(function (k) {
                    var p = document.createElement('div');
                    p.className = 'text-danger';
                    p.innerText = k + ': ' + obj.errors[k].join('; ');
                    container.appendChild(p);
                });
            } else if (obj.error) {
                var p = document.createElement('div');
                p.className = 'text-danger';
                p.innerText = obj.error;
                container.appendChild(p);
            }
        }

        document.getElementById('staffTable').addEventListener('click', function (e) {
            if (e.target.classList.contains('btn-edit')) {
                var tr = e.target.closest('tr');
                var id = tr.getAttribute('data-id');
                // populate modal
                document.getElementById('StaffId').value = id;
                document.getElementById('FirstName').value = tr.children[1].innerText;
                document.getElementById('LastName').value = tr.children[2].innerText;
                document.getElementById('EmailAddress').value = tr.children[3].innerText;
                document.getElementById('Gender').value = tr.children[4].innerText;
                document.getElementById('PhoneNumber').value = tr.children[5].innerText;
                document.getElementById('ZipCode').value = tr.children[6].innerText;
                $('#editorModal').modal('show');
                clearEditorErrors();
            }

            if (e.target.classList.contains('btn-delete')) {
                var tr = e.target.closest('tr');
                var id = tr.getAttribute('data-id');
                if (!confirm('Delete staff ' + id + '?')) return;
                fetch('/api/staffs/' + id, { method: 'DELETE' })
                    .then(function (r) { if (r.ok) tr.parentNode.removeChild(tr); else return r.json().then(showEditorErrors); })
                    .catch(function () { alert('Delete failed'); });
            }
        });

        document.getElementById('btnAdd').addEventListener('click', function () {
            document.getElementById('StaffId').value = '';
            document.getElementById('FirstName').value = '';
            document.getElementById('LastName').value = '';
            document.getElementById('EmailAddress').value = '';
            document.getElementById('Gender').value = 'M';
            document.getElementById('PhoneNumber').value = '';
            document.getElementById('ZipCode').value = '';
            $('#editorModal').modal('show');
            clearEditorErrors();
        });

        document.getElementById('btnSave').addEventListener('click', function () {
            clearEditorErrors();
            var id = document.getElementById('StaffId').value;
            var payload = {
                StaffId: id ? parseInt(id) : 0,
                FirstName: document.getElementById('FirstName').value,
                LastName: document.getElementById('LastName').value,
                EmailAddress: document.getElementById('EmailAddress').value,
                Gender: document.getElementById('Gender').value,
                PhoneNumber: document.getElementById('PhoneNumber').value,
                ZipCode: document.getElementById('ZipCode').value,
                Address: document.getElementById('Address').value
            };

            var url = id ? '?handler=Update' : '?handler=Create';
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(function (r) {
                if (r.ok) return r.json().catch(function () { return payload; });
                return r.json().then(function (j) { throw j; });
            }).then(function (data) {
                $('#editorModal').modal('hide');
                // refresh page or update row in-place
                location.reload();
            }).catch(function (err) {
                showEditorErrors(err);
            });
        });
    })();
</script>
