@page
@model InpremClockingApp.Pages.TestProvisionModel
@{
    ViewData["Title"] = "Test account provisioning";
}

<h1>Test account provisioning</h1>
<p>This temporary staging tool creates confirmed accounts with passwords and does not send email.</p>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (Model.Success != null)
{
    <div class="alert alert-success">@Model.Success</div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="AccessSecret" class="form-label">Provisioning secret</label>
        <input asp-for="AccessSecret" type="password" class="form-control" autocomplete="off" required />
    </div>
    <div class="mb-3">
        <label asp-for="AccountType" class="form-label">Account type</label>
        <select asp-for="AccountType" class="form-select">
            <option value="provider">Provider user</option>
            <option value="owner">Organization and owner</option>
            <option value="admin">Organization administrator</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Username/email</label>
        <input asp-for="Email" type="text" class="form-control" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Initial password</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
    </div>
    <div class="row">
        <div class="col mb-3">
            <label asp-for="FirstName" class="form-label">First name</label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col mb-3">
            <label asp-for="LastName" class="form-label">Last name</label>
            <input asp-for="LastName" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="ProviderRole" class="form-label">Provider role</label>
        <select asp-for="ProviderRole" class="form-select">
            <option value="Support">Support</option>
            <option value="Billing">Billing</option>
            <option value="Owner">Owner</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="TenantId" class="form-label">Organization ID (administrator only)</label>
        <input asp-for="TenantId" type="number" min="1" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="OrganizationName" class="form-label">Organization name (owner only)</label>
        <input asp-for="OrganizationName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="OrganizationSlug" class="form-label">Organization slug (optional)</label>
        <input asp-for="OrganizationSlug" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create test account</button>
</form>
