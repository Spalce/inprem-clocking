@page
@model OneStaffClockingReport
@{
    ViewData["Title"] = "Staff Clocking Report";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Individual Staff Clocking Report</h1>
                </div>
                <div class="col-sm-6 text-sm-right">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Individual Staff Clocking Report</li>
                    </ol>
                    <button type="button" id="btnDownloadPdf" class="btn btn-danger btn-sm">Download PDF</button>
                </div>
            </div>
        </div>
    </div>
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div style="width:100%;">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Staff</th>
                                <th>Date</th>
                                <th>Clock In</th>
                                <th>Clock Out</th>
                                <th>Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ReportRows)
                            {
                                <tr>
                                    <td>@row.FullName</td>
                                    <td>@OrgClock.ToLocal(row.CreatedAt)?.ToString("yyyy-MM-dd")</td>
                                    <td>@(OrgClock.ToLocal(row.ClockInTime)?.ToString("HH:mm:ss") ?? "")</td>
                                    <td>@(OrgClock.ToLocal(row.ClockOutTime)?.ToString("HH:mm:ss") ?? "")</td>
                                    <td>@(row.WorkingHours?.ToString(@"hh\:mm\:ss") ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('btnDownloadPdf').addEventListener('click', function () {
        var url = '/api/people/staff-hours-pdf?id=@Model.StaffId&start=@Uri.EscapeDataString(Model.Start.ToString("o"))&end=@Uri.EscapeDataString(Model.End.ToString("o"))';
        fetch(url)
            .then(function (res) { if (!res.ok) throw new Error('PDF failed'); return res.blob(); })
            .then(function (blob) {
                var u = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = u;
                a.download = 'staff-@Model.StaffId-hours.pdf';
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(u);
            })
            .catch(function () { alert('Failed to download PDF'); });
    });
</script>
