@page
@model OneStaffClockingReport
@{
    ViewData["Title"] = "Staff Clocking Report";
    var btnDanger = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-red-600 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-red-700";
}

<div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-6 tw:sm:px-6 tw:lg:px-8">
  <div class="tw:mb-6 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
    <h1 class="tw:text-2xl tw:font-semibold tw:text-slate-900">Individual Staff Clocking Report</h1>
    <div class="tw:flex tw:items-center tw:gap-4">
      <nav class="tw:text-sm tw:text-slate-500">
        <a href="#" class="tw:hover:text-slate-700">Home</a>
        <span class="tw:mx-1">/</span>
        <span class="tw:text-slate-700">Individual Staff Clocking Report</span>
      </nav>
      <button type="button" id="btnDownloadPdf" class="@btnDanger">Download PDF</button>
    </div>
  </div>

  <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white">
    <div class="tw:overflow-x-auto">
      <table class="tw:min-w-full tw:divide-y tw:divide-slate-200">
        <thead class="tw:bg-slate-50">
          <tr>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Staff</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Date</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Clock In</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Clock Out</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Hours</th>
          </tr>
        </thead>
        <tbody class="tw:divide-y tw:divide-slate-100">
          @foreach (var row in Model.ReportRows)
          {
            <tr class="tw:hover:bg-slate-50">
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@row.FullName</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@OrgClock.ToLocal(row.CreatedAt)?.ToString("yyyy-MM-dd")</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@(OrgClock.ToLocal(row.ClockInTime)?.ToString("HH:mm:ss") ?? "")</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@(OrgClock.ToLocal(row.ClockOutTime)?.ToString("HH:mm:ss") ?? "")</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@(row.WorkingHours?.ToString(@"hh\:mm\:ss") ?? "")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
    document.getElementById('btnDownloadPdf').addEventListener('click', function () {
        var url = '/api/people/staff-hours-pdf?id=@Model.StaffId&start=@Uri.EscapeDataString(Model.Start.ToString("o"))&end=@Uri.EscapeDataString(Model.End.ToString("o"))';
        fetch(url)
            .then(function (res) { if (!res.ok) throw new Error('PDF failed'); return res.blob(); })
            .then(function (blob) {
                var u = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = u;
                a.download = 'staff-@Model.StaffId-hours.pdf';
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(u);
            })
            .catch(function () { alert('Failed to download PDF'); });
    });
</script>
