@page
@model Volunteer
@using InpremClockingApp.Models
@{
    ViewData["Title"] = "Volunteer List";
    var input = "tw:w-full tw:rounded-md tw:border tw:border-slate-300 tw:px-3 tw:py-2 tw:text-sm tw:text-slate-900 tw:focus:border-blue-500 tw:focus:outline-none tw:focus:ring-1 tw:focus:ring-blue-500";
    var label = "tw:mb-1 tw:block tw:text-sm tw:font-medium tw:text-slate-700";
    var btnPrimary = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border-0 tw:bg-blue-600 tw:px-4 tw:py-2 tw:text-sm tw:font-medium tw:text-white tw:hover:bg-blue-700";
    var btnWhite = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border tw:border-slate-300 tw:bg-white tw:px-3 tw:py-2 tw:text-sm tw:font-medium tw:text-slate-700 tw:hover:bg-slate-50";
    var actionBtn = "tw:inline-flex tw:cursor-pointer tw:items-center tw:justify-center tw:rounded-md tw:border tw:border-slate-300 tw:bg-white tw:px-2.5 tw:py-1 tw:text-xs tw:font-medium tw:text-slate-700 tw:hover:bg-slate-50";
}

<div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-6 tw:sm:px-6 tw:lg:px-8">
  <div class="tw:mb-6 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
    <h1 class="tw:text-2xl tw:font-semibold tw:text-slate-900">Volunteers List (Total: @(ViewData["TotalCount"] ?? 0))</h1>
    <nav class="tw:text-sm tw:text-slate-500">
      <a href="#" class="tw:hover:text-slate-700">Home</a>
      <span class="tw:mx-1">/</span>
      <span class="tw:text-slate-700">Volunteers List</span>
    </nav>
  </div>

  <div class="tw:mb-4 tw:flex tw:flex-col tw:gap-3 tw:sm:flex-row tw:sm:items-start tw:sm:justify-between">
    <div class="tw:flex tw:flex-1 tw:items-start tw:gap-2">
      <div class="tw:relative tw:flex-1">
        <input id="vemailSearch" placeholder="Search by name or email..." class="@input" autocomplete="off" value="@ViewData["Search"]" />
        <div id="vemailHint" class="tw:mt-1 tw:text-xs tw:text-slate-500">Type to search all volunteers</div>
      </div>
      <button id="vbtnSearch" class="@btnWhite">Search</button>
    </div>
    <button id="vbtnAdd" class="@btnPrimary">Add New</button>
  </div>

  <div class="tw:mb-3 tw:flex tw:flex-wrap tw:gap-2">
    <button type="button" id="vbtnExportCopy" class="@actionBtn">Copy</button>
    <button type="button" id="vbtnExportCsv" class="@actionBtn">CSV</button>
    <button type="button" id="vbtnExportExcel" class="@actionBtn">Excel</button>
    <button type="button" id="vbtnExportPdf" class="@actionBtn">PDF</button>
    <button type="button" id="vbtnExportPrint" class="@actionBtn">Print</button>
  </div>

  <div class="tw:overflow-hidden tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white">
    <div class="tw:overflow-x-auto">
      <table class="tw:min-w-full tw:divide-y tw:divide-slate-200" id="volunteerTable">
        <thead class="tw:bg-slate-50">
          <tr>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">ID</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">First Name</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Last Name</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Email</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Gender</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Phone</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Zip</th>
            <th class="tw:px-4 tw:py-3 tw:text-left tw:text-xs tw:font-semibold tw:uppercase tw:tracking-wide tw:text-slate-500">Actions</th>
          </tr>
        </thead>
        <tbody class="tw:divide-y tw:divide-slate-100">
          @foreach (var v in Model.Volunteers ?? Enumerable.Empty<InpremClockingApp.Models.Volunteer>())
          {
            <tr data-id="@v.VolunteerId" data-address="@v.Address" data-created-at="@v.CreatedAt?.ToString("O")" data-volunteer-category="@v.VolunteerCategory" data-mandate-type="@v.MandateType" data-institution-name="@v.InstitutionName" data-place-of-work="@v.PlaceOfWork" data-contact-person="@v.ContactPerson" data-contact-person-position="@v.ContactPersonPosition" data-contact-person-email="@v.ContactPersonEmail" data-contact-person-phone="@v.ContactPersonPhone" class="tw:hover:bg-slate-50">
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.VolunteerId</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.FirstName</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.LastName</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.EmailAddress</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.Gender</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.PhoneNumber</td>
              <td class="tw:px-4 tw:py-3 tw:text-sm tw:whitespace-nowrap tw:text-slate-700">@v.ZipCode</td>
              <td class="tw:px-4 tw:py-3 tw:whitespace-nowrap">
                <div class="tw:flex tw:gap-1.5">
                  <button type="button" class="@actionBtn vbtn-edit">Edit</button>
                  <button type="button" class="@actionBtn vbtn-move">Move To Staff</button>
                  <a href="/HoursWorked?type=volunteer&id=@v.VolunteerId" class="@actionBtn">Hours</a>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-3 tw:border-t tw:border-slate-200 tw:px-4 tw:py-3 tw:sm:flex-row tw:sm:items-center tw:sm:justify-between">
      <form id="pageSizeForm" method="get" class="tw:flex tw:items-center tw:gap-2">
        <label class="tw:text-sm tw:text-slate-600">Page size</label>
        @{ var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100; }
        <select name="pageSize" id="pageSizeSelect" class="tw:rounded-md tw:border tw:border-slate-300 tw:px-2 tw:py-1 tw:text-sm" onchange="document.getElementById('pageSizeForm').submit();">
          <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
          <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
          <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
          <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
        </select>
        <input type="hidden" name="pageNumber" value="1" />
        <input type="hidden" name="Search" value="@ViewData["Search"]" />
      </form>

      <nav aria-label="Page navigation">
        <ul class="tw:flex tw:items-center tw:gap-1">
          @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
          <li>
            <a class="tw:rounded-md tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium @(current == 1 ? "tw:pointer-events-none tw:text-slate-300" : "tw:text-slate-600 tw:hover:bg-slate-100")" asp-page="./Volunteer" asp-route-pageNumber="@(current-1)" asp-route-pageSize="@size" asp-route-Search="@ViewData["Search"]">Previous</a>
          </li>
          @for (int i = 1; i <= total; i++)
          {
            <li>
              <a class="tw:rounded-md tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium @(i == current ? "tw:bg-blue-600 tw:text-white" : "tw:text-slate-600 tw:hover:bg-slate-100")" asp-page="./Volunteer" asp-route-pageNumber="@i" asp-route-pageSize="@size" asp-route-Search="@ViewData["Search"]">@i</a>
            </li>
          }
          <li>
            <a class="tw:rounded-md tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium @(current == total ? "tw:pointer-events-none tw:text-slate-300" : "tw:text-slate-600 tw:hover:bg-slate-100")" asp-page="./Volunteer" asp-route-pageNumber="@(current+1)" asp-route-pageSize="@size" asp-route-Search="@ViewData["Search"]">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>

<div id="veditorModal" data-modal-root class="tw:fixed tw:inset-0 tw:z-50 tw:hidden">
  <div class="tw:fixed tw:inset-0 tw:bg-black/50" data-modal-dismiss="veditorModal"></div>
  <div class="tw:pointer-events-none tw:fixed tw:inset-0 tw:flex tw:items-center tw:justify-center tw:p-4">
    <div class="tw:pointer-events-auto tw:max-h-[90vh] tw:w-full tw:max-w-lg tw:overflow-y-auto tw:rounded-lg tw:bg-white tw:shadow-xl">
      <div class="tw:flex tw:items-center tw:justify-between tw:border-b tw:border-slate-200 tw:px-4 tw:py-3">
        <h5 id="veditorModalTitle" class="tw:text-base tw:font-semibold tw:text-slate-900">Edit Volunteer</h5>
        <button type="button" class="tw:cursor-pointer tw:border-0 tw:bg-transparent tw:text-xl tw:leading-none tw:text-slate-400 tw:hover:text-slate-600" data-modal-dismiss="veditorModal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="tw:p-4">
        <div id="veditorErrors" class="tw:mb-2"></div>
        <form id="veditorForm">
          <input type="hidden" name="VolunteerId" id="VolunteerId" />
          <div class="tw:mb-3">
            <label class="@label">First Name</label>
            <input class="@input" name="FirstName" id="vFirstName" />
          </div>
          <div class="tw:mb-3">
            <label class="@label">Last Name</label>
            <input class="@input" name="LastName" id="vLastName" />
          </div>
          <div class="tw:mb-3">
            <label class="@label">Email</label>
            <input class="@input" name="EmailAddress" id="vEmailAddress" />
          </div>
          <div class="tw:mb-3">
            <label class="@label">Gender</label>
            <select class="@input" name="Gender" id="vGender">
              <option value="M">M</option>
              <option value="F">F</option>
            </select>
          </div>
          <div class="tw:mb-3">
            <label class="@label">Phone</label>
            <input class="@input" name="PhoneNumber" id="vPhoneNumber" />
          </div>
          <div class="tw:mb-3">
            <label class="@label">Zip</label>
            <input class="@input" name="ZipCode" id="vZipCode" />
          </div>
          <div class="tw:mb-3">
            <label class="@label">Address</label>
            <textarea class="@input" name="Address" id="vAddress"></textarea>
          </div>
          <div class="tw:mb-3">
            <label class="@label">Which volunteer category do you fall under?</label>
            <select class="@input" name="VolunteerCategory" id="vVolunteerCategory">
              <option value="">-- Select category --</option>
              <option value="@VolunteerCategories.MandatedCommunityHours">Mandated Community Hours</option>
              <option value="@VolunteerCategories.MofcVolunteerHub">MOFC Volunteer Hub</option>
              <option value="@VolunteerCategories.EducationalPurposes">Educational Purposes</option>
              <option value="@VolunteerCategories.CorporateVolunteering">Corporate Volunteering</option>
              <option value="@VolunteerCategories.PersonalOrIndividualVolunteering">Personal or Individual Volunteering</option>
            </select>
          </div>
          <div class="tw:mb-3" id="vMandateTypeGroup" style="display:none;">
            <label class="@label">Which of these applies to you?</label>
            <select class="@input" name="MandateType" id="vMandateType">
              <option value="">-- Select --</option>
              <option value="@VolunteerMandateTypes.CourtOrders">Court orders</option>
              <option value="@VolunteerMandateTypes.Diversion">Diversion</option>
              <option value="@VolunteerMandateTypes.YouthDetention">Youth Detention</option>
            </select>
          </div>
          <div class="tw:mb-3" id="vInstitutionGroup" style="display:none;">
            <label class="@label">Name of Institution</label>
            <input class="@input" name="InstitutionName" id="vInstitutionName" />
          </div>
          <div class="tw:mb-3" id="vPlaceOfWorkGroup" style="display:none;">
            <label class="@label">Place of Work</label>
            <input class="@input" name="PlaceOfWork" id="vPlaceOfWork" />
          </div>
          <div class="tw:mb-3" id="vContactPersonGroup" style="display:none;">
            <label class="@label">Contact Person</label>
            <input class="@input" name="ContactPerson" id="vContactPerson" />
          </div>
          <div class="tw:mb-3" id="vContactPersonPositionGroup" style="display:none;">
            <label class="@label">Contact Person Position</label>
            <input class="@input" name="ContactPersonPosition" id="vContactPersonPosition" />
          </div>
          <div class="tw:mb-3" id="vContactPersonEmailGroup" style="display:none;">
            <label class="@label">Contact Person Email</label>
            <input class="@input" name="ContactPersonEmail" id="vContactPersonEmail" />
          </div>
          <div class="tw:mb-3" id="vContactPersonPhoneGroup" style="display:none;">
            <label class="@label">Contact Person Phone</label>
            <input class="@input" name="ContactPersonPhone" id="vContactPersonPhone" />
          </div>
        </form>
      </div>
      <div class="tw:flex tw:justify-end tw:gap-2 tw:border-t tw:border-slate-200 tw:px-4 tw:py-3">
        <button type="button" class="@btnWhite" data-modal-dismiss="veditorModal">Close</button>
        <button type="button" id="vbtnSave" class="@btnPrimary">Save</button>
      </div>
    </div>
  </div>
</div>

<script>
    (function () {
        var table = document.getElementById('volunteerTable');
        var searchInput = document.getElementById('vemailSearch');
        var hint = document.getElementById('vemailHint');
        var timer = null;

        function rowToPayload(tr) {
            return {
                VolunteerId: parseInt(tr.getAttribute('data-id') || '0'),
                FirstName: tr.children[1].innerText,
                LastName: tr.children[2].innerText,
                EmailAddress: tr.children[3].innerText,
                Gender: tr.children[4].innerText,
                PhoneNumber: tr.children[5].innerText,
                ZipCode: tr.children[6].innerText,
                Address: tr.getAttribute('data-address') || '',
                CreatedAt: tr.getAttribute('data-created-at') || null,
                VolunteerCategory: tr.getAttribute('data-volunteer-category') || '',
                MandateType: tr.getAttribute('data-mandate-type') || '',
                InstitutionName: tr.getAttribute('data-institution-name') || '',
                PlaceOfWork: tr.getAttribute('data-place-of-work') || '',
                ContactPerson: tr.getAttribute('data-contact-person') || '',
                ContactPersonPosition: tr.getAttribute('data-contact-person-position') || '',
                ContactPersonEmail: tr.getAttribute('data-contact-person-email') || '',
                ContactPersonPhone: tr.getAttribute('data-contact-person-phone') || ''
            };
        }

        // Mirrors VolunteerAttendance.cshtml's conditional-fields behavior so the admin "Add
        // New"/"Edit" modal asks the same follow-up questions as the kiosk sign-up form.
        var MANDATED = '@VolunteerCategories.MandatedCommunityHours';
        var EDUCATIONAL = '@VolunteerCategories.EducationalPurposes';
        var CORPORATE = '@VolunteerCategories.CorporateVolunteering';

        function setConditionalVisible(group, input, visible) {
            group.style.display = visible ? '' : 'none';
            if (!visible) input.value = '';
        }

        function updateVolunteerConditionalFields() {
            var value = document.getElementById('vVolunteerCategory').value;
            setConditionalVisible(document.getElementById('vMandateTypeGroup'), document.getElementById('vMandateType'), value === MANDATED);
            setConditionalVisible(document.getElementById('vInstitutionGroup'), document.getElementById('vInstitutionName'), value === EDUCATIONAL);
            setConditionalVisible(document.getElementById('vPlaceOfWorkGroup'), document.getElementById('vPlaceOfWork'), value === CORPORATE);
            setConditionalVisible(document.getElementById('vContactPersonGroup'), document.getElementById('vContactPerson'), value === EDUCATIONAL || value === CORPORATE);
            // Position/email/phone are only collected for Educational Purposes, unlike the
            // contact person's name above which is also asked for Corporate Volunteering.
            setConditionalVisible(document.getElementById('vContactPersonPositionGroup'), document.getElementById('vContactPersonPosition'), value === EDUCATIONAL);
            setConditionalVisible(document.getElementById('vContactPersonEmailGroup'), document.getElementById('vContactPersonEmail'), value === EDUCATIONAL);
            setConditionalVisible(document.getElementById('vContactPersonPhoneGroup'), document.getElementById('vContactPersonPhone'), value === EDUCATIONAL);
        }

        document.getElementById('vVolunteerCategory').addEventListener('change', updateVolunteerConditionalFields);

        function clearEditorErrors() {
            document.getElementById('veditorErrors').innerHTML = '';
        }

        function showEditorErrors(obj) {
            var container = document.getElementById('veditorErrors');
            container.innerHTML = '';
            if (obj && obj.errors) {
                Object.keys(obj.errors).forEach(function (key) {
                    var p = document.createElement('div');
                    p.className = 'tw:text-sm tw:text-red-600';
                    p.innerText = key + ': ' + obj.errors[key].join('; ');
                    container.appendChild(p);
                });
            } else {
                var p = document.createElement('div');
                p.className = 'tw:text-sm tw:text-red-600';
                p.innerText = obj && obj.error ? obj.error : 'Request failed.';
                container.appendChild(p);
            }
        }

        function setModalTitle(text) {
            document.getElementById('veditorModalTitle').innerText = text;
        }

        function openEditor(payload) {
            document.getElementById('VolunteerId').value = payload.VolunteerId || '';
            document.getElementById('vFirstName').value = payload.FirstName || '';
            document.getElementById('vLastName').value = payload.LastName || '';
            document.getElementById('vEmailAddress').value = payload.EmailAddress || '';
            document.getElementById('vGender').value = payload.Gender || 'M';
            document.getElementById('vPhoneNumber').value = payload.PhoneNumber || '';
            document.getElementById('vZipCode').value = payload.ZipCode || '';
            document.getElementById('vAddress').value = payload.Address || '';
            document.getElementById('vVolunteerCategory').value = payload.VolunteerCategory || '';
            updateVolunteerConditionalFields();
            document.getElementById('vMandateType').value = payload.MandateType || '';
            document.getElementById('vInstitutionName').value = payload.InstitutionName || '';
            document.getElementById('vPlaceOfWork').value = payload.PlaceOfWork || '';
            document.getElementById('vContactPerson').value = payload.ContactPerson || '';
            document.getElementById('vContactPersonPosition').value = payload.ContactPersonPosition || '';
            document.getElementById('vContactPersonEmail').value = payload.ContactPersonEmail || '';
            document.getElementById('vContactPersonPhone').value = payload.ContactPersonPhone || '';
            clearEditorErrors();
            setModalTitle(payload.VolunteerId ? 'Edit Volunteer' : 'New Volunteer');
            openModal('veditorModal');
        }

        // Rows are server-paginated, so search re-runs the query server-side (page reset to 1)
        // rather than hiding/showing rows already in the DOM - a client-only filter would only
        // ever see whichever page happens to be loaded.
        function navigateSearch(value) {
            var params = new URLSearchParams(window.location.search);
            if (value) params.set('Search', value); else params.delete('Search');
            params.set('pageNumber', '1');
            window.location.href = window.location.pathname + '?' + params.toString();
        }

        function showHints(list) {
            hint.innerHTML = '';
            list.slice(0, 10).forEach(function (email) {
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'tw:mr-2 tw:cursor-pointer tw:border-0 tw:bg-transparent tw:p-0 tw:text-sm tw:text-blue-600 tw:hover:underline';
                button.textContent = email;
                button.addEventListener('click', function () {
                    navigateSearch(email);
                });
                hint.appendChild(button);
            });
        }

        table.addEventListener('click', function (event) {
            var tr = event.target.closest('tr');
            if (!tr) return;

            if (event.target.classList.contains('vbtn-edit')) {
                openEditor(rowToPayload(tr));
            }

            if (event.target.classList.contains('vbtn-move')) {
                if (!confirm('Move volunteer to staff?')) return;
                fetch('?handler=Move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(rowToPayload(tr))
                }).then(function (response) {
                    if (response.ok || response.redirected) location.reload();
                    else return response.json().then(showEditorErrors);
                }).catch(function () {
                    showEditorErrors({ error: 'Move failed.' });
                });
            }
        });

        document.getElementById('vbtnAdd').addEventListener('click', function () {
            openEditor({ Gender: 'M' });
        });

        document.getElementById('vbtnSearch').addEventListener('click', function () {
            navigateSearch(searchInput.value || '');
        });

        document.getElementById('vbtnSave').addEventListener('click', function () {
            clearEditorErrors();
            var id = document.getElementById('VolunteerId').value;
            var payload = {
                VolunteerId: id ? parseInt(id) : 0,
                FirstName: document.getElementById('vFirstName').value,
                LastName: document.getElementById('vLastName').value,
                EmailAddress: document.getElementById('vEmailAddress').value,
                Gender: document.getElementById('vGender').value,
                PhoneNumber: document.getElementById('vPhoneNumber').value,
                ZipCode: document.getElementById('vZipCode').value,
                Address: document.getElementById('vAddress').value,
                VolunteerCategory: document.getElementById('vVolunteerCategory').value,
                MandateType: document.getElementById('vMandateType').value,
                InstitutionName: document.getElementById('vInstitutionName').value,
                PlaceOfWork: document.getElementById('vPlaceOfWork').value,
                ContactPerson: document.getElementById('vContactPerson').value,
                ContactPersonPosition: document.getElementById('vContactPersonPosition').value,
                ContactPersonEmail: document.getElementById('vContactPersonEmail').value,
                ContactPersonPhone: document.getElementById('vContactPersonPhone').value
            };

            fetch(id ? '?handler=Update' : '?handler=Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(function (response) {
                if (response.ok || response.redirected) {
                    closeModal('veditorModal');
                    location.reload();
                    return;
                }
                return response.json().then(function (json) { throw json; });
            }).catch(showEditorErrors);
        });

        searchInput.addEventListener('input', function () {
            var value = searchInput.value || '';
            if (timer) clearTimeout(timer);
            timer = setTimeout(function () {
                if (!value) {
                    hint.innerText = 'Type to search all volunteers';
                    return;
                }
                fetch('/api/people/emails?q=' + encodeURIComponent(value))
                    .then(function (response) { return response.ok ? response.json() : []; })
                    .then(showHints)
                    .catch(function () { hint.innerHTML = ''; });
            }, 250);
        });

        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (timer) clearTimeout(timer);
                navigateSearch(searchInput.value || '');
            }
        });

        // Export buttons always act on every row matching the currently-applied Search filter
        // (not just the page on screen), mirrored server-side in Volunteer.cshtml.cs's handlers.
        function currentSearchParam() {
            return new URLSearchParams(window.location.search).get('Search') || '';
        }

        function exportUrl(handler) {
            return '?handler=' + handler + '&Search=' + encodeURIComponent(currentSearchParam());
        }

        function fetchAllRows() {
            return fetch(exportUrl('ExportJson')).then(function (r) { return r.json(); });
        }

        document.getElementById('vbtnExportCsv').addEventListener('click', function () {
            window.location.href = exportUrl('ExportCsv');
        });

        document.getElementById('vbtnExportExcel').addEventListener('click', function () {
            window.location.href = exportUrl('ExportExcel');
        });

        document.getElementById('vbtnExportPdf').addEventListener('click', function () {
            window.location.href = exportUrl('ExportPdf');
        });

        document.getElementById('vbtnExportCopy').addEventListener('click', function () {
            fetchAllRows().then(function (rows) {
                var lines = [['ID', 'First Name', 'Last Name', 'Email', 'Gender', 'Phone', 'Zip'].join('\t')];
                rows.forEach(function (r) {
                    lines.push([r.id, r.firstName, r.lastName, r.email, r.gender, r.phone, r.zip].join('\t'));
                });
                navigator.clipboard.writeText(lines.join('\n')).then(function () {
                    showToast(rows.length + ' row(s) copied to clipboard', 3000, 'success');
                }).catch(function () {
                    showToast('Could not copy to clipboard', 3000, 'danger');
                });
            });
        });

        document.getElementById('vbtnExportPrint').addEventListener('click', function () {
            fetchAllRows().then(function (rows) {
                var html = '<html><head><title>Volunteer List</title></head><body>'
                    + '<h3>Volunteer List</h3>'
                    + '<table border="1" cellspacing="0" cellpadding="4">'
                    + '<tr><th>ID</th><th>First Name</th><th>Last Name</th><th>Email</th><th>Gender</th><th>Phone</th><th>Zip</th></tr>';
                rows.forEach(function (r) {
                    html += '<tr><td>' + r.id + '</td><td>' + r.firstName + '</td><td>' + r.lastName + '</td><td>'
                        + r.email + '</td><td>' + r.gender + '</td><td>' + r.phone + '</td><td>' + r.zip + '</td></tr>';
                });
                html += '</table></body></html>';
                var w = window.open('', '_blank');
                w.document.write(html);
                w.document.close();
                w.focus();
                w.print();
            });
        });
    })();
</script>
