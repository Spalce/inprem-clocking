@page
@model Volunteer
@{
    ViewData["Title"] = "Volunteer List";
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Volunteers List (Total: @(ViewData["TotalCount"] ?? 0))</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Volunteers List</li>
        </ol>
      </div>
    </div>
  </div>
        <div class="modal fade" id="vhoursModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Volunteer Hours</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="vhoursForm">
                <input type="hidden" id="vhVolunteerId" name="VolunteerId" />
                <div class="form-group">
                    <label>Start</label>
                    <input type="date" id="vhStart" name="Start" class="form-control" />
                </div>
                <div class="form-group">
                    <label>End</label>
                    <input type="date" id="vhEnd" name="End" class="form-control" />
                </div>
                <div id="vhoursResult" class="mt-3"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="vbtnDownloadPdf" class="btn btn-primary">Download PDF</button>
                <button type="button" id="vbtnCalculate" class="btn btn-info">Calculate</button>
            </div>
            </div>
        </div>
        </div>
</div>
<div class="content">
  <div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between mb-2">
                <div style="flex:1" class="d-flex">
                    <div style="flex:1">
                        <input id="vemailSearch" placeholder="Search by name or email..." class="form-control" autocomplete="off" value="@ViewData["Search"]" />
                        <div id="vemailHint" class="small text-muted mt-1">Type to search all volunteers</div>
                    </div>
                    <button id="vbtnSearch" class="btn btn-outline-secondary ml-2" style="height:38px;">Search</button>
                </div>
                <div class="ml-2">
                    <button id="vbtnAdd" class="btn btn-primary">Add New</button>
                </div>
            </div>

            <table class="table table-striped" id="volunteerTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Zip</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Volunteers ?? Enumerable.Empty<InpremClockingApp.Models.Volunteer>())
                    {
                        <tr data-id="@v.VolunteerId" data-address="@v.Address" data-created-at="@v.CreatedAt?.ToString("O")">
                            <td>@v.VolunteerId</td>
                            <td>@v.FirstName</td>
                            <td>@v.LastName</td>
                            <td>@v.EmailAddress</td>
                            <td>@v.Gender</td>
                            <td>@v.PhoneNumber</td>
                            <td>@v.ZipCode</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-secondary vbtn-edit">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-info vbtn-move">Move To Staff</button>
                                @* <button type="button" class="btn btn-sm btn-outline-primary vbtn-hours">Hours</button> *@
                                <a href="/HoursWorked?type=volunteer&id=@v.VolunteerId"
                                    class="btn btn-sm btn-outline-primary">
                                    Hours
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between align-items-center my-3">
                <div>
                    <form id="vpageSizeForm" method="get" class="form-inline">
                        <label class="mr-2">Page size</label>
                        @{ var currentSize = (int)(ViewData["PageSize"] ?? 20); var vsel10 = currentSize == 10; var vsel20 = currentSize == 20; var vsel50 = currentSize == 50; var vsel100 = currentSize == 100; }
                        <select name="pageSize" id="vpageSizeSelect" class="form-control" onchange="document.getElementById('vpageSizeForm').submit();">
                            <option value="10" selected="@(vsel10 ? "selected" : null)">10</option>
                            <option value="20" selected="@(vsel20 ? "selected" : null)">20</option>
                            <option value="50" selected="@(vsel50 ? "selected" : null)">50</option>
                            <option value="100" selected="@(vsel100 ? "selected" : null)">100</option>
                        </select>
                        <input type="hidden" name="pageNumber" value="1" />
                        <input type="hidden" name="Search" value="@ViewData["Search"]" />
                    </form>
                </div>

                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                        <li class="page-item @(current == 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="./Volunteer" asp-route-pageNumber="@(current-1)" asp-route-pageSize="@size" asp-route-Search="@ViewData["Search"]">Previous</a>
                        </li>
                        @for (int i = 1; i <= total; i++)
                        {
                            <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./Volunteer" asp-route-pageNumber="@i" asp-route-pageSize="@size" asp-route-Search="@ViewData["Search"]">@i</a></li>
                        }
                        <li class="page-item @(current == total ? "disabled" : "")">
                            <a class="page-link" asp-page="./Volunteer" asp-route-pageNumber="@(current+1)" asp-route-pageSize="@size" asp-route-Search="@ViewData["Search"]">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>

            <div class="modal fade" id="veditorModal" tabindex="-1" role="dialog" aria-hidden="true">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title">Edit Volunteer</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">
                    <div id="veditorErrors"></div>
                    <form id="veditorForm">
                        <input type="hidden" name="VolunteerId" id="VolunteerId" />
                        <div class="form-group">
                            <label>First Name</label>
                            <input class="form-control" name="FirstName" id="vFirstName" />
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input class="form-control" name="LastName" id="vLastName" />
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input class="form-control" name="EmailAddress" id="vEmailAddress" />
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select class="form-control" name="Gender" id="vGender">
                                <option value="M">M</option>
                                <option value="F">F</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input class="form-control" name="PhoneNumber" id="vPhoneNumber" />
                        </div>
                        <div class="form-group">
                            <label>Zip</label>
                            <input class="form-control" name="ZipCode" id="vZipCode" />
                        </div>
                        <div class="form-group">
                            <label>Address</label>
                            <textarea class="form-control" name="Address" id="vAddress"></textarea>
                        </div>
                    </form>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" id="vbtnSave" class="btn btn-primary">Save</button>
                  </div>
                </div>
              </div>
            </div>
        </div>
    </div>
  </div>
</div>
</div>

<script>
    (function () {
        var table = document.getElementById('volunteerTable');
        var searchInput = document.getElementById('vemailSearch');
        var hint = document.getElementById('vemailHint');
        var timer = null;

        function rowToPayload(tr) {
            return {
                VolunteerId: parseInt(tr.getAttribute('data-id') || '0'),
                FirstName: tr.children[1].innerText,
                LastName: tr.children[2].innerText,
                EmailAddress: tr.children[3].innerText,
                Gender: tr.children[4].innerText,
                PhoneNumber: tr.children[5].innerText,
                ZipCode: tr.children[6].innerText,
                Address: tr.getAttribute('data-address') || '',
                CreatedAt: tr.getAttribute('data-created-at') || null
            };
        }

        function clearEditorErrors() {
            document.getElementById('veditorErrors').innerHTML = '';
        }

        function showEditorErrors(obj) {
            var container = document.getElementById('veditorErrors');
            container.innerHTML = '';
            if (obj && obj.errors) {
                Object.keys(obj.errors).forEach(function (key) {
                    var p = document.createElement('div');
                    p.className = 'text-danger';
                    p.innerText = key + ': ' + obj.errors[key].join('; ');
                    container.appendChild(p);
                });
            } else {
                var p = document.createElement('div');
                p.className = 'text-danger';
                p.innerText = obj && obj.error ? obj.error : 'Request failed.';
                container.appendChild(p);
            }
        }

        function setModalTitle(text) {
            document.querySelector('#veditorModal .modal-title').innerText = text;
        }

        function openEditor(payload) {
            document.getElementById('VolunteerId').value = payload.VolunteerId || '';
            document.getElementById('vFirstName').value = payload.FirstName || '';
            document.getElementById('vLastName').value = payload.LastName || '';
            document.getElementById('vEmailAddress').value = payload.EmailAddress || '';
            document.getElementById('vGender').value = payload.Gender || 'M';
            document.getElementById('vPhoneNumber').value = payload.PhoneNumber || '';
            document.getElementById('vZipCode').value = payload.ZipCode || '';
            document.getElementById('vAddress').value = payload.Address || '';
            clearEditorErrors();
            setModalTitle(payload.VolunteerId ? 'Edit Volunteer' : 'New Volunteer');
            $('#veditorModal').modal('show');
        }

        // Rows are server-paginated, so search re-runs the query server-side (page reset to 1)
        // rather than hiding/showing rows already in the DOM - a client-only filter would only
        // ever see whichever page happens to be loaded.
        function navigateSearch(value) {
            var params = new URLSearchParams(window.location.search);
            if (value) params.set('Search', value); else params.delete('Search');
            params.set('pageNumber', '1');
            window.location.href = window.location.pathname + '?' + params.toString();
        }

        function showHints(list) {
            hint.innerHTML = '';
            list.slice(0, 10).forEach(function (email) {
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'btn btn-link p-0 mr-2';
                button.textContent = email;
                button.addEventListener('click', function () {
                    navigateSearch(email);
                });
                hint.appendChild(button);
            });
        }

        table.addEventListener('click', function (event) {
            var tr = event.target.closest('tr');
            if (!tr) return;

            if (event.target.classList.contains('vbtn-edit')) {
                openEditor(rowToPayload(tr));
            }

            if (event.target.classList.contains('vbtn-move')) {
                if (!confirm('Move volunteer to staff?')) return;
                fetch('?handler=Move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(rowToPayload(tr))
                }).then(function (response) {
                    if (response.ok || response.redirected) location.reload();
                    else return response.json().then(showEditorErrors);
                }).catch(function () {
                    showEditorErrors({ error: 'Move failed.' });
                });
            }

            if (event.target.classList.contains('vbtn-hours')) {
                var payload = rowToPayload(tr);
                document.getElementById('vhVolunteerId').value = payload.VolunteerId;
                // default dates: last 30 days
                var end = new Date();
                var start = new Date(); start.setDate(end.getDate() - 30);
                document.getElementById('vhStart').value = start.toISOString().slice(0,10);
                document.getElementById('vhEnd').value = end.toISOString().slice(0,10);
                document.getElementById('vhoursResult').innerHTML = '';
                $('#vhoursModal').modal('show');
            }
        });

        document.getElementById('vbtnAdd').addEventListener('click', function () {
            openEditor({ Gender: 'M' });
        });

        document.getElementById('vbtnSearch').addEventListener('click', function () {
            navigateSearch(searchInput.value || '');
        });

        // Hours modal actions
        document.getElementById('vbtnCalculate').addEventListener('click', function () {
            var id = document.getElementById('vhVolunteerId').value;
            var s = document.getElementById('vhStart').value;
            var e = document.getElementById('vhEnd').value;
            if (!id) return;
            fetch(`/api/people/volunteer-hours?id=${encodeURIComponent(id)}&start=${encodeURIComponent(s)}&end=${encodeURIComponent(e)}`)
                .then(r => r.json())
                .then(json => {
                    document.getElementById('vhoursResult').innerHTML = `
                        <div class="mt-3">
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>Total Hours Clocked</span>
                                <strong>${json.totalClockedDisplay}</strong>
                            </div>

                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>Total Hours for Break</span>
                                <strong>${json.totalBreakDisplay}</strong>
                            </div>

                            <div class="d-flex justify-content-between py-2">
                                <span>Actual Hours Worked</span>
                                <strong>${json.actualWorkedDisplay}</strong>
                            </div>
                        </div>`;
                    
                    // store last result for PDF
                    document.getElementById('vhoursResult').dataset.last = JSON.stringify(json);
                }).catch(()=> document.getElementById('vhoursResult').innerHTML = '<div class="text-danger">Failed to calculate hours.</div>');
        });

        document.getElementById('vbtnDownloadPdf').addEventListener('click', function () {
            var data = document.getElementById('vhoursResult').dataset.last;
            if (!data) {
                alert('Please calculate hours first');
                return;
            }
            var json = JSON.parse(data);
            // request server PDF generation endpoint
            fetch(`/api/people/volunteer-hours-pdf?id=${encodeURIComponent(json.volunteerId)}&start=${encodeURIComponent(json.start)}&end=${encodeURIComponent(json.end)}`)
                .then(function (res) { if (!res.ok) throw new Error('PDF failed'); return res.blob(); })
                .then(function (blob) { var url = URL.createObjectURL(blob); var a = document.createElement('a'); a.href = url; a.download = `volunteer-${json.volunteerId}-hours.pdf`; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url); })
                .catch(function () { alert('Failed to download PDF'); });
        });

        document.getElementById('vbtnSave').addEventListener('click', function () {
            clearEditorErrors();
            var id = document.getElementById('VolunteerId').value;
            var payload = {
                VolunteerId: id ? parseInt(id) : 0,
                FirstName: document.getElementById('vFirstName').value,
                LastName: document.getElementById('vLastName').value,
                EmailAddress: document.getElementById('vEmailAddress').value,
                Gender: document.getElementById('vGender').value,
                PhoneNumber: document.getElementById('vPhoneNumber').value,
                ZipCode: document.getElementById('vZipCode').value,
                Address: document.getElementById('vAddress').value
            };

            fetch(id ? '?handler=Update' : '?handler=Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(function (response) {
                if (response.ok || response.redirected) {
                    $('#veditorModal').modal('hide');
                    location.reload();
                    return;
                }
                return response.json().then(function (json) { throw json; });
            }).catch(showEditorErrors);
        });

        searchInput.addEventListener('input', function () {
            var value = searchInput.value || '';
            if (timer) clearTimeout(timer);
            timer = setTimeout(function () {
                if (!value) {
                    hint.innerText = 'Type to search all volunteers';
                    return;
                }
                fetch('/api/people/emails?q=' + encodeURIComponent(value))
                    .then(function (response) { return response.ok ? response.json() : []; })
                    .then(showHints)
                    .catch(function () { hint.innerHTML = ''; });
            }, 250);
        });

        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (timer) clearTimeout(timer);
                navigateSearch(searchInput.value || '');
            }
        });
    })();
</script>
