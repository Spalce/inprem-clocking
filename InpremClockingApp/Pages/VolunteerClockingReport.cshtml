@page
@model VolunteerClockingReport
@{
    ViewData["Title"] = "Volunteer Clocking Report";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Volunteer Clocking Report</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Volunteer Clocking Report</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div style="width:100%;">
                    <form method="get" class="mb-3">
                      @if (ViewData["Error"] != null)
                      {
                          <div class="alert alert-danger">@ViewData["Error"]</div>
                      }
                      <div class="form-row">
                        <div class="col-md-3">
                          <label>Select Volunteer</label>
                          <select class="form-control d-none" id="volunteerSelect">
                            <option value="">-- All --</option>
                            @foreach (var v in Model.Volunteers ?? Enumerable.Empty<InpremClockingApp.Models.Volunteer>())
                            {
                                var isSelected = ViewData["VolunteerId"] != null && ViewData["VolunteerId"].ToString() == v.VolunteerId.ToString();
                                <option value="@v.VolunteerId" selected="@(isSelected ? "selected" : null)">@v.FullName</option>
                            }
                          </select>
                          <input type="text" id="volunteerLookup" class="form-control" placeholder="Search volunteer..." />
                          <input type="hidden" name="VolunteerId" id="VolunteerIdHidden" value="@(ViewData["VolunteerId"] ?? "")" />
                        </div>
                        <div class="col-md-3">
                          <label>Start</label>
                          <input name="Start" type="datetime-local" class="form-control" value="@(ViewData["Start"] ?? "")" />
                        </div>
                        <div class="col-md-3">
                          <label>End</label>
                          <input name="End" type="datetime-local" class="form-control" value="@(ViewData["End"] ?? "")" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                          <button class="btn btn-primary">Filter</button>
                        </div>
                      </div>
                    </form>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Volunteer</th>
                                <th>Date</th>
                                <th>Clock In</th>
                                <th>Clock Out</th>
                                <th>Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.ReportRows)
                            {
                                var item = r.Clocking?.FirstOrDefault();
                                <tr>
                                    <td>@(item?.FullName ?? "")</td>
                                    <td>@(OrgClock.ToLocal(item?.CreatedAt)?.ToString("yyyy-MM-dd") ?? "")</td>
                                    <td>@(OrgClock.ToLocal(item?.ClockInTime)?.ToString("HH:mm:ss") ?? "")</td>
                                    <td>@(OrgClock.ToLocal(item?.ClockOutTime)?.ToString("HH:mm:ss") ?? "")</td>
                                    <td>@(item?.WorkingHours?.ToString(@"hh\:mm\:ss") ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center my-3">
                        <div>
                            <form id="reportPageSizeForm" method="get" class="form-inline">
                                <label class="mr-2">Page size</label>
                                @{ var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100; }
                                <select name="pageSize" id="reportPageSizeSelect" class="form-control" onchange="document.getElementById('reportPageSizeForm').submit();">
                                    <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
                                    <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
                                    <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
                                    <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
                                </select>
                                <input type="hidden" name="pageNumber" value="1" />
                                <input type="hidden" name="VolunteerId" value="@(ViewData["VolunteerId"])" />
                                <input type="hidden" name="Start" value="@(ViewData["Start"])" />
                                <input type="hidden" name="End" value="@(ViewData["End"])" />
                            </form>
                        </div>

                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center mb-0">
                                @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                                <li class="page-item @(current == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-page="./VolunteerClockingReport" asp-route-pageNumber="@(current-1)" asp-route-pageSize="@size" asp-route-VolunteerId="@ViewData["VolunteerId"]" asp-route-Start="@ViewData["Start"]" asp-route-End="@ViewData["End"]">Previous</a>
                                </li>
                                @for (int i = 1; i <= total; i++)
                                {
                                    <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./VolunteerClockingReport" asp-route-pageNumber="@i" asp-route-pageSize="@size" asp-route-VolunteerId="@ViewData["VolunteerId"]" asp-route-Start="@ViewData["Start"]" asp-route-End="@ViewData["End"]">@i</a></li>
                                }
                                <li class="page-item @(current == total ? "disabled" : "")">
                                    <a class="page-link" asp-page="./VolunteerClockingReport" asp-route-pageNumber="@(current+1)" asp-route-pageSize="@size" asp-route-VolunteerId="@ViewData["VolunteerId"]" asp-route-Start="@ViewData["Start"]" asp-route-End="@ViewData["End"]">Next</a>
                                </li>
                            </ul>
                        </nav>

                        <div>
                            <small class="text-muted">@(ViewData["TotalCount"] ?? 0) total record(s)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
  (function(){
    const input = document.getElementById('volunteerLookup');
    const hidden = document.getElementById('VolunteerIdHidden');
    let timer = null;

    function renderSuggestions(items){
      let container = document.getElementById('vol-suggestions');
      if(!container){
        container = document.createElement('div');
        container.id = 'vol-suggestions';
        container.className = 'list-group position-absolute';
        input.parentNode.appendChild(container);
      }
      container.innerHTML = '';
        items.forEach(i => {
        const el = document.createElement('button');
        el.type = 'button';
        el.className = 'list-group-item list-group-item-action';
        el.textContent = i.text;
        el.addEventListener('click', function(){
          // set hidden id and navigate using querystring to ensure server receives the VolunteerId
          input.value = i.text;
          hidden.value = i.id;
          container.innerHTML = '';
          try {
            const params = new URLSearchParams(window.location.search);
            params.set('VolunteerId', i.id);
            const startEl = document.querySelector('input[name="Start"]');
            const endEl = document.querySelector('input[name="End"]');
            if (startEl && startEl.value) params.set('Start', startEl.value);
            if (endEl && endEl.value) params.set('End', endEl.value);
            window.location.href = window.location.pathname + '?' + params.toString();
          } catch (e) {
            const form = input.closest('form');
            if (form) form.submit();
          }
        });

    // If user types a name but doesn't pick a suggestion, resolve it on submit to the first match
    (function(){
      const form = input.closest('form');
      if(!form) return;
      form.addEventListener('submit', function(e){
        try {
          if(!hidden.value && input.value && input.value.trim()){
            e.preventDefault();
            fetch(`/api/people/volunteers?q=${encodeURIComponent(input.value)}&page=1&pageSize=1`)
              .then(r => r.json())
              .then(json => {
                const items = json.items || [];
                if(items.length){
                  const id = items[0].id;
                  const params = new URLSearchParams(window.location.search);
                  params.set('VolunteerId', id);
                  const startEl = document.querySelector('input[name="Start"]');
                  const endEl = document.querySelector('input[name="End"]');
                  if (startEl && startEl.value) params.set('Start', startEl.value);
                  if (endEl && endEl.value) params.set('End', endEl.value);
                  window.location.href = window.location.pathname + '?' + params.toString();
                } else {
                  form.submit();
                }
              })
              .catch(()=> form.submit());
          }
        } catch {}
      });
    })();
        container.appendChild(el);
      });
    }

    input.addEventListener('input', function(e){
      const q = e.target.value;
      hidden.value = ''; // clear selection when typing
      if(timer) clearTimeout(timer);
      if(!q) { renderSuggestions([]); return; }
      timer = setTimeout(()=>{
        fetch(`/api/people/volunteers?q=${encodeURIComponent(q)}&page=1&pageSize=10`)
          .then(r=>r.json())
          .then(json=> renderSuggestions(json.items || []))
          .catch(()=> renderSuggestions([]));
      }, 250);
    });

    // prefill input from selected hidden id or from querystring on load
    (function(){
      try {
        if(hidden.value){
          const select = document.getElementById('volunteerSelect');
          if(select){
            const opt = Array.from(select.options).find(o => o.value === hidden.value);
            if(opt) input.value = opt.text;
          }
        } else {
          const params = new URLSearchParams(window.location.search);
          const vid = params.get('VolunteerId');
          if(vid){
            hidden.value = vid;
            const select = document.getElementById('volunteerSelect');
            if(select){
              const opt = Array.from(select.options).find(o => o.value === vid);
              if(opt) input.value = opt.text;
            }
          }
        }
      } catch {}
    })();
  })();
</script>

