@page
@model StaffClocking
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Staff Clocking";
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Staff Clocking</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Staff Clocking</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
      <div class="row">
          <div class="col-md-12" style="margin-bottom: 30px;">
              <div class="card card-primary card-outline">
                <div class="card-header">
                  <h5 class="m-0">Manual Clocking Here</h5>
                </div>
                <div class="card-body">
                  <form asp-page="StaffClocking" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="staffSelect">Select Staff</label>
                                <select id="staffSelect" name="ClockingStaff.StafId" class="form-control" required>
                                    <option value="">-- Select staff --</option>
                                    @foreach (var s in Model.Model.Staff ?? Enumerable.Empty<InpremClockingApp.Models.Staff>())
                                    {
                                        <option value="@s.StaffId">@s.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="clockIn">Clock In</label>
                                <input id="clockIn" name="ClockingStaff.ClockInTime" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-2">
                                <label for="clockOut">Clock Out</label>
                                <input id="clockOut" name="ClockingStaff.ClockOutTime" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button id="btnClockIn" type="submit" class="btn btn-primary">Clock In</button>
                            </div>
                        </div>
                  </form>
                </div>
              </div>
          </div>
          <div class="col-md-12">
              <form method="get" class="form-inline mb-3">
                <div class="form-row w-100">
                  <div class="col-md-3">
                    <label>Select Staff</label>
                    <select name="StaffId" class="form-control">
                      <option value="">-- All --</option>
                      @foreach (var s in Model.Model.Staff ?? Enumerable.Empty<InpremClockingApp.Models.Staff>())
                      {
                        var isSelected = ViewData["StaffId"] != null && ViewData["StaffId"].ToString() == s.StaffId.ToString();
                        <option value="@s.StaffId" selected="@(isSelected ? "selected" : null)">@s.FullName</option>
                      }
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label>Start</label>
                    <input name="Start" type="datetime-local" class="form-control" value="@(ViewData["Start"] ?? "")" />
                  </div>
                  <div class="col-md-3">
                    <label>End</label>
                    <input name="End" type="datetime-local" class="form-control" value="@(ViewData["End"] ?? "")" />
                  </div>
                  <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary">Filter</button>
                  </div>
                </div>
              </form>
          </div>
          <div class="col-md-12">
              <div class="table-responsive">
                <div class="mb-3">
                  <input id="searchBox" class="form-control" placeholder="Search by name..." />
                </div>
                <table class="table table-striped" id="clockingTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th>Break Start</th>
                            <th>Break End</th>
                            <th>Working</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Model?.Clocking ?? Enumerable.Empty<InpremClockingApp.Models.ClockingStaff>())
                        {
                            <tr>
                                <td>@c.ClockingStaffId</td>
                                <td>@c.FullName</td>
                                <td>@c.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                <td>@(c.ClockInTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.ClockOutTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.LeaveOnBreakTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.ReturnOnBreakTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.WorkingHours?.ToString() ?? "")</td>
                                <td>
                                    <button class="btn btn-sm btn-success" onclick="postAction('ClockOut', { ClockingStaffId: @c.ClockingStaffId })">Clock Out</button>
                                    <button class="btn btn-sm btn-warning" onclick="postAction('BreakStart', { ClockingStaffId: @c.ClockingStaffId })">Break Start</button>
                                    <button class="btn btn-sm btn-info" onclick="postAction('BreakEnd', { ClockingStaffId: @c.ClockingStaffId })">Break End</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <nav aria-label="Page navigation">
                  <ul class="pagination justify-content-center">
                    @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                    <li class="page-item @(current == 1 ? "disabled" : "")">
                      <a class="page-link" asp-page="./StaffClocking" asp-route-page="@(current-1)" asp-route-pageSize="@size" asp-route-StaffId="@(ViewData["StaffId"])" asp-route-Start="@(ViewData["Start"])" asp-route-End="@(ViewData["End"])">Previous</a>
                    </li>
                    @for (int i = 1; i <= total; i++)
                    {
                        <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./StaffClocking" asp-route-page="@i" asp-route-pageSize="@size" asp-route-StaffId="@(ViewData["StaffId"])" asp-route-Start="@(ViewData["Start"])" asp-route-End="@(ViewData["End"])">@i</a></li>
                    }
                    <li class="page-item @(current == total ? "disabled" : "")">
                      <a class="page-link" asp-page="./StaffClocking" asp-route-page="@(current+1)" asp-route-pageSize="@size" asp-route-StaffId="@(ViewData["StaffId"])" asp-route-Start="@(ViewData["Start"])" asp-route-End="@(ViewData["End"])">Next</a>
                    </li>
                  </ul>
                </nav>
              </div>
          </div>
      </div>
  </div>
</div>
</div>

<script>

    async function postAction(action, data) {
        try {
            const res = await fetch(`?handler=${action}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                location.reload();
            } else {
                console.error('Action failed', await res.text());
                location.reload();
            }
        } catch (err) {
            console.error(err);
            location.reload();
        }
    }

    // Simple client-side search
    document.getElementById('searchBox').addEventListener('input', function (e) {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('#clockingTable tbody tr').forEach(function (tr) {
            const name = tr.children[1].textContent.toLowerCase();
            tr.style.display = name.indexOf(q) === -1 ? 'none' : '';
        });
    });

    // Prefill clock-in with current local time when opening the page
    document.addEventListener('DOMContentLoaded', function () {
        const now = new Date();
        const isoLocal = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0,16);
        document.getElementById('clockIn').value = isoLocal;
    });

</script>
