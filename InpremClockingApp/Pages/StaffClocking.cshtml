@page
@model StaffClocking
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Staff Clocking";
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Staff Clocking</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Staff Clocking</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
      <div class="row">
          <div class="col-md-12" style="margin-bottom: 30px;">
              <div class="card card-primary card-outline">
                <div class="card-header">
                  <h5 class="m-0">Manual Clocking Here</h5>
                </div>
                <div class="card-body">
                  <form asp-page="StaffClocking" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="staffSelect">Select Staff</label>
                                <select id="staffSelect" asp-for="ClockingStaff.StafId" class="form-control" required>
                                    <option value="">-- Select staff --</option>
                                    @foreach (var s in Model.Model.Staff ?? Enumerable.Empty<InpremClockingApp.Models.Staff>())
                                    {
                                        <option value="@s.StaffId">@s.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="clockIn">Clock In</label>
                                <input id="clockIn" asp-for="ClockingStaff.ClockInTime" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-2">
                                <label for="clockOut">Clock Out</label>
                                <input id="clockOut" asp-for="ClockingStaff.ClockOutTime" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button id="btnClockIn" type="submit" class="btn btn-primary">Clock In</button>
                            </div>
                        </div>
                  </form>
                </div>
              </div>
          </div>
          <div class="col-md-12">
              <div class="table-responsive">
                <div class="mb-3">
                  <input id="searchBox" class="form-control" placeholder="Search by name..." />
                </div>
                <table class="table table-striped" id="clockingTable">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th>Break Start</th>
                            <th>Break End</th>
                            <th>Working</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Model?.Clocking ?? Enumerable.Empty<InpremClockingApp.Models.ClockingStaff>())
                        {
                            <tr>
                                @* <td>@c.ClockingStaffId</td> *@
                                <td>@c.FullName</td>
                                <td>@c.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                <td>@(c.ClockInTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.ClockOutTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.LeaveOnBreakTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.ReturnOnBreakTime?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.WorkingHours?.ToString() ?? "")</td>
                                <td>
                                    <button class="btn btn-sm btn-success" onclick="postAction('ClockOut', { ClockingStaffId: @c.ClockingStaffId })">Clock Out</button>
                                    <button class="btn btn-sm btn-warning" onclick="postAction('BreakStart', { ClockingStaffId: @c.ClockingStaffId })">Break Start</button>
                                    <button class="btn btn-sm btn-info" onclick="postAction('BreakEnd', { ClockingStaffId: @c.ClockingStaffId })">Break End</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center my-3">
                    <div>
                        <form id="pageSizeForm" method="get" class="form-inline">
                            <label class="mr-2">Page size</label>
                            @{
                                var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100;
                            }
                            <select name="pageSize" id="pageSizeSelect" class="form-control" onchange="document.getElementById('pageSizeForm').submit();">
                                <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
                                <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
                                <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
                                <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
                            </select>
                            <input type="hidden" name="page" value="1" />
                        </form>
                    </div>

                
                  <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                      @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                      <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./StaffClocking" asp-route-page="@(current-1)" asp-route-pageSize="@size">Previous</a>
                      </li>
                      @for (int i = 1; i <= total; i++)
                      {
                          <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./StaffClocking" asp-route-page="@i" asp-route-pageSize="@size">@i</a></li>
                      }
                      <li class="page-item @(current == total ? "disabled" : "")">
                        <a class="page-link" asp-page="./StaffClocking" asp-route-page="@(current+1)" asp-route-pageSize="@size">Next</a>
                      </li>
                    </ul>
                  </nav>
                </div>
              </div>
          </div>
      </div>
  </div>
</div>
</div>

<script>

    async function postAction(action, data) {
        try {
            const res = await fetch(`?handler=${action}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                location.reload();
            } else {
                console.error('Action failed', await res.text());
                location.reload();
            }
        } catch (err) {
            console.error(err);
            location.reload();
        }
    }

    // Simple client-side search
    document.getElementById('searchBox').addEventListener('input', function (e) {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('#clockingTable tbody tr').forEach(function (tr) {
            const name = tr.children[1].textContent.toLowerCase();
            tr.style.display = name.indexOf(q) === -1 ? 'none' : '';
        });
    });

    // Prefill clock-in with current local time when opening the page
    document.addEventListener('DOMContentLoaded', function () {
        const now = new Date();
        const isoLocal = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0,16);
        document.getElementById('clockIn').value = isoLocal;
    });

</script>
