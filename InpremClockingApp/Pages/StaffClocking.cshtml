@page
@model StaffClocking
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@{
    ViewData["Title"] = "Staff Clocking";
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Staff Clocking</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Staff Clocking</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
      <div class="row">
          <div class="col-md-12" style="margin-bottom: 30px;">
              <div class="card card-primary card-outline">
                <div class="card-header">
                  <h5 class="m-0">Manual Clocking Here</h5>
                </div>
                <div class="card-body">
                  <form asp-page="StaffClocking" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="staffLookup">Search Staff (name or email)</label>
                                @{
                                    var selectedStaff = Model.ClockingStaff?.StafId > 0
                                        ? (Model.Model.Staff ?? Enumerable.Empty<InpremClockingApp.Models.Staff>()).FirstOrDefault(s => s.StaffId == Model.ClockingStaff.StafId)
                                        : null;
                                }
                                <input type="text" id="staffLookup" class="form-control" placeholder="Search by name or email..." autocomplete="off" value="@selectedStaff?.FullName" required />
                                <input type="hidden" asp-for="ClockingStaff.StafId" id="staffIdHidden" />
                            </div>
                            <div class="col-md-2">
                                <label for="clockIn">Clock In</label>
                                <input id="clockIn" asp-for="ClockingStaff.ClockInTime" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-2">
                                <label for="clockOut">Clock Out</label>
                                <input id="clockOut" asp-for="ClockingStaff.ClockOutTime" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button id="btnClockIn" type="submit" class="btn btn-primary">Clock In</button>
                            </div>
                        </div>
                  </form>
                </div>
              </div>
          </div>
          <div class="col-md-12">
              <div class="table-responsive">
                <table class="table table-striped" id="clockingTable">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th>Break Start</th>
                            <th>Break End</th>
                            <th>Working</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Model?.Clocking ?? Enumerable.Empty<InpremClockingApp.Models.ClockingStaff>())
                        {
                            <tr>
                                @* <td>@c.ClockingStaffId</td> *@
                                <td>@c.FullName</td>
                                <td>@OrgClock.ToLocal(c.CreatedAt)?.ToString("yyyy-MM-dd")</td>
                                <td>@(OrgClock.ToLocal(c.ClockInTime)?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(OrgClock.ToLocal(c.ClockOutTime)?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(OrgClock.ToLocal(c.LeaveOnBreakTime)?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(OrgClock.ToLocal(c.ReturnOnBreakTime)?.ToString("HH:mm:ss") ?? "")</td>
                                <td>@(c.WorkingHours?.ToString() ?? "")</td>
                                <td>
                                    <button class="btn btn-sm btn-success" onclick="postAction('ClockOut', { ClockingStaffId: @c.ClockingStaffId })">Clock Out</button>
                                    <button class="btn btn-sm btn-warning" onclick="postAction('BreakStart', { ClockingStaffId: @c.ClockingStaffId })">Break Start</button>
                                    <button class="btn btn-sm btn-info" onclick="postAction('BreakEnd', { ClockingStaffId: @c.ClockingStaffId })">Break End</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center my-3">
                    <div>
                        <form id="pageSizeForm" method="get" class="form-inline">
                            <label class="mr-2">Page size</label>
                            @{
                                var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100;
                            }
                            <select name="pageSize" id="pageSizeSelect" class="form-control" onchange="document.getElementById('pageSizeForm').submit();">
                                <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
                                <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
                                <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
                                <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
                            </select>
                            <input type="hidden" name="page" value="1" />
                        </form>
                    </div>

                
                  <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                      @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                      <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./StaffClocking" asp-route-page="@(current-1)" asp-route-pageSize="@size">Previous</a>
                      </li>
                      @for (int i = 1; i <= total; i++)
                      {
                          <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./StaffClocking" asp-route-page="@i" asp-route-pageSize="@size">@i</a></li>
                      }
                      <li class="page-item @(current == total ? "disabled" : "")">
                        <a class="page-link" asp-page="./StaffClocking" asp-route-page="@(current+1)" asp-route-pageSize="@size">Next</a>
                      </li>
                    </ul>
                  </nav>
                </div>
              </div>
          </div>
      </div>
  </div>
</div>
</div>

<script>

    async function postAction(action, data) {
        try {
            const res = await fetch(`?handler=${action}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                location.reload();
            } else {
                console.error('Action failed', await res.text());
                location.reload();
            }
        } catch (err) {
            console.error(err);
            location.reload();
        }
    }

    // Staff search-and-select (name or email) for the manual clocking form
    (function () {
        const input = document.getElementById('staffLookup');
        const hidden = document.getElementById('staffIdHidden');
        let timer = null;
        let container = null;

        function ensureContainer() {
            if (!container) {
                container = document.createElement('div');
                container.className = 'list-group position-absolute';
                container.style.zIndex = '1000';
                container.style.width = '100%';
                input.parentNode.appendChild(container);
            }
            return container;
        }

        function renderSuggestions(items) {
            const c = ensureContainer();
            c.innerHTML = '';
            items.forEach(function (i) {
                const el = document.createElement('button');
                el.type = 'button';
                el.className = 'list-group-item list-group-item-action';
                el.textContent = i.email ? `${i.text} (${i.email})` : i.text;
                el.addEventListener('click', function () {
                    input.value = i.text;
                    hidden.value = i.id;
                    input.setCustomValidity('');
                    c.innerHTML = '';
                });
                c.appendChild(el);
            });
        }

        input.addEventListener('input', function (e) {
            hidden.value = '';
            input.setCustomValidity('');
            const q = e.target.value;
            if (timer) clearTimeout(timer);
            if (!q) { renderSuggestions([]); return; }
            timer = setTimeout(function () {
                fetch(`/api/people/staff?q=${encodeURIComponent(q)}&page=1&pageSize=10`)
                    .then(function (r) { return r.json(); })
                    .then(function (json) { renderSuggestions(json.items || []); })
                    .catch(function () { renderSuggestions([]); });
            }, 250);
        });

        document.addEventListener('click', function (evt) {
            if (container && !container.contains(evt.target) && evt.target !== input) {
                container.innerHTML = '';
            }
        });

        const form = input.closest('form');
        if (form) {
            form.addEventListener('submit', function (e) {
                if (!hidden.value) {
                    e.preventDefault();
                    input.setCustomValidity('Please pick a staff member from the search results.');
                    input.reportValidity();
                }
            });
        }
    })();

    // Prefill clock-in with current local time when opening the page
    document.addEventListener('DOMContentLoaded', function () {
        const now = new Date();
        const isoLocal = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0,16);
        document.getElementById('clockIn').value = isoLocal;
    });

</script>
