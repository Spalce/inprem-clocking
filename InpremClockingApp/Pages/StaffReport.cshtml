@page
@model StaffReport
@{
    ViewData["Title"] = "Staff Report";
}

<div class="content-wrapper">
<div class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0">Staff Report (Total: @(ViewData["TotalCount"] ?? 0))</h1>
      </div>
      <div class="col-sm-6 text-sm-right">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Staff Report</li>
        </ol>
        <button type="button" id="btnDownloadPdf" class="btn btn-danger btn-sm">Download PDF</button>
      </div>
    </div>
  </div>
</div>
<div class="content">
  <div class="container-fluid">
    <div class="row">
      <div style="width:100%;">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.StaffList)
                {
                    <tr>
                        <td>@s.FirstName</td>
                        <td>@s.LastName</td>
                        <td>@s.EmailAddress</td>
                        <td>@s.PhoneNumber</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center my-3">
            <div>
                <form id="pageSizeForm" method="get" class="form-inline">
                    <label class="mr-2">Page size</label>
                    @{ var currentSize = (int)(ViewData["PageSize"] ?? 20); var sel10 = currentSize == 10; var sel20 = currentSize == 20; var sel50 = currentSize == 50; var sel100 = currentSize == 100; }
                    <select name="pageSize" id="pageSizeSelect" class="form-control" onchange="document.getElementById('pageSizeForm').submit();">
                        <option value="10" selected="@(sel10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(sel20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(sel50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(sel100 ? "selected" : null)">100</option>
                    </select>
                    <input type="hidden" name="pageNumber" value="1" />
                </form>
            </div>

            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    @{ var current = (int)(ViewData["Page"] ?? 1); var total = (int)(ViewData["TotalPages"] ?? 1); var size = (int)(ViewData["PageSize"] ?? 20); }
                    <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./StaffReport" asp-route-pageNumber="@(current-1)" asp-route-pageSize="@size">Previous</a>
                    </li>
                    @for (int i = 1; i <= total; i++)
                    {
                        <li class="page-item @(i == current ? "active" : "")"><a class="page-link" asp-page="./StaffReport" asp-route-pageNumber="@i" asp-route-pageSize="@size">@i</a></li>
                    }
                    <li class="page-item @(current == total ? "disabled" : "")">
                        <a class="page-link" asp-page="./StaffReport" asp-route-pageNumber="@(current+1)" asp-route-pageSize="@size">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<script>
    document.getElementById('btnDownloadPdf').addEventListener('click', function () {
        fetch('/api/people/staff-list-pdf')
            .then(function (res) { if (!res.ok) throw new Error('PDF failed'); return res.blob(); })
            .then(function (blob) {
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'staff-list.pdf';
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
            })
            .catch(function () { alert('Failed to download PDF'); });
    });
</script>

