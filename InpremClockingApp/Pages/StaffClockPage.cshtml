@page "/staff-clockin/{id:long}"
@model StaffClockPage
@using Microsoft.AspNetCore.Authorization;
@inject InpremClockingApp.Services.ITenantClock TenantClock
@attribute [Authorize]
@{
  Layout = "Shared/_MainLayout";
  ViewData["Title"] = "Staff Clocking Controls";
  var id = (long?)ViewData["id"] ?? 0;
  var kioskBtn = "tw:block tw:w-full tw:cursor-pointer tw:rounded-lg tw:border-0 tw:px-6 tw:py-5 tw:text-center tw:text-lg tw:font-semibold tw:text-white tw:shadow-sm";
}

<div class="tw:mx-auto tw:max-w-7xl tw:px-4 tw:py-6 tw:sm:px-6 tw:lg:px-8">
  <div class="tw:mb-6 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
    <h1 class="tw:text-2xl tw:font-semibold tw:text-slate-900">Staff Clocking System</h1>
    <nav class="tw:text-sm tw:text-slate-500">
      <a href="#" class="tw:hover:text-slate-700">Home</a>
      <span class="tw:mx-1">/</span>
      <span class="tw:text-slate-700">Clocking System</span>
    </nav>
  </div>

  <div class="tw:mx-auto tw:max-w-md tw:rounded-lg tw:border tw:border-slate-200 tw:bg-white tw:p-8 tw:shadow-sm">
    <p class="tw:text-center tw:text-base tw:font-medium tw:text-slate-600">Please clock in</p>
    <p id="current-date" class="tw:mt-2 tw:text-center tw:text-lg tw:font-semibold tw:text-slate-900">@TenantClock.NowLocal().ToString("dd-MM-yyyy")</p>
    <p id="current-time" class="tw:mb-6 tw:text-center tw:text-lg tw:font-semibold tw:text-slate-900">@TenantClock.NowLocal().ToString("HH:mm:ss")</p>

    <div class="tw:flex tw:flex-col tw:gap-3">
      <a class="@kioskBtn tw:bg-emerald-600 tw:hover:bg-emerald-700" id="clockin">Clock In</a>
      <a class="@kioskBtn tw:bg-blue-600 tw:hover:bg-blue-700" id="leavein">Leave for Break</a>
      <a class="@kioskBtn tw:bg-amber-500 tw:hover:bg-amber-600" id="leaveout">Return from Break</a>
      <a class="@kioskBtn tw:bg-red-600 tw:hover:bg-red-700" id="clockout">Clock Out</a>
    </div>
  </div>
</div>

<script >

    $("#clockin").click(function(){
        $.ajax({
            url: "/api/controls/staff-clockin/" + @id,
            type: "GET",
            success: function(response) {
                showToast(response, 5000, 'success');
                $.ajax({
                    url: "/api/controls/get-logout",
                    type: "GET",
                    success: function(response) {
                        if (response === true) {
                            window.location.assign('/Identity/Account/Logout');
                        }
                        else
                        {
                            window.location.assign('/StaffAttendance');
                        }
                    },
                    error: function (xhr) {
                       // showToast('Oops! An error occured. Try again', 5000, 'danger');
                    }
                });
            },
            error: function (xhr) {
                if (xhr.status === 409) {
                    // Rejected on purpose (already clocked in/out today) - not an error.
                    showToast(xhr.responseJSON || 'You have already clocked in today.', 5000, 'warning');
                } else {
                    showToast('Oops! An error occured. Try again', 5000, 'danger');
                }
            }
        });
    });

    $("#leavein").click(function() {
        $.ajax({
            url: "/api/controls/staff-leavein/" + @id,
            type: "GET",
            success: function(response) {
                showToast(response, 5000, 'success');
                window.location.assign('/StaffAttendance');
            },
            error: function (xhr) {
               showToast('Oops! An error occured. Try again', 5000, 'danger');
            }
        });
    });

    $("#leaveout").click(function() {
        $.ajax({
            url: "/api/controls/staff-leaveout/" + @id,
            type: "GET",
            success: function(response) {
                showToast(response, 5000, 'success');
                window.location.assign('/StaffAttendance');
            },
            error: function (xhr) {
               showToast('Oops! An error occured. Try again', 5000, 'danger');
            }
        });
    });

    $("#clockout").click(function() {
        $.ajax({
            url: "/api/controls/staff-clockout/" + @id,
            type: "GET",
            success: function(response) {
                showToast(response, 5000, 'success');
                window.location.assign('/StaffAttendance');
            },
            error: function (xhr) {
               showToast('Oops! An error occured. Try again', 5000, 'danger');
            }
        });
    });

</script>
